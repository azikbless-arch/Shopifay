<section class="bs-section"><div class="bs-shell"><div class="bs-collection-hero"><p class="bs-eyebrow">EXPLORE BLESSHOP</p><h1>Shop by Collection</h1><p>Find useful things for every part of your everyday life.</p></div><div class="bs-category-grid bs-category-grid--all">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<a class="bs-category-card bs-cat-blush" href="{{ collection.url }}"><div class="bs-category-card__image">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: collection.title }}{% elsif collection.products.first.featured_image %}{{ collection.products.first.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}<span class="bs-category-symbol">♡</span>{% endif %}</div><div class="bs-category-card__foot"><strong>{{ collection.title }}</strong><span>›</span></div></a>{% endunless %}{% endfor %}</div></div></section>
{% schema %}{"name":"Premium collection list","settings":[],"presets":[{"name":"Premium collection list"}]}{% endschema %}
