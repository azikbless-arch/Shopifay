<section class="bs-section bs-v4-finder" data-bs-v4-finder>
  <div class="bs-shell">
    <div class="bs-v4-heading"><span class="bs-v4-eyebrow">PERSONAL SHOPPING JOURNEY</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p></div>
    <div class="bs-v4-finder__surface">
      <div class="bs-v4-finder__options" role="group" aria-label="Select shopping interest">
        {% for block in section.blocks %}
          <button type="button" class="bs-v4-finder__option" data-bs-v4-finder-tab="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><span aria-hidden="true">{{ block.settings.symbol | escape }}</span>{{ block.settings.label | escape }}</button>
        {% endfor %}
      </div>
      {% for block in section.blocks %}
        {% assign bs_pick = block.settings.collection %}
        {% if bs_pick == blank %}
          {% case block.settings.fallback %}
            {% when 'pets' %}{% assign bs_pick = collections['pet-supplies'] %}
            {% when 'home' %}{% assign bs_pick = collections['home-living'] %}
            {% when 'beauty' %}{% assign bs_pick = collections['beauty-care'] %}
            {% when 'gadgets' %}{% assign bs_pick = collections['tech-gadgets'] %}
            {% when 'fashion' %}{% assign bs_pick = collections['fashion'] %}
          {% endcase %}
        {% endif %}
        <div class="bs-v4-finder__panel" data-bs-v4-finder-panel="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="bs-v4-finder__panel-head"><div><span class="bs-v4-eyebrow">YOUR SELECTION</span><h3>{{ block.settings.label | escape }}</h3></div>{% if bs_pick != blank %}<a href="{{ bs_pick.url }}">Browse collection ↗</a>{% endif %}</div>
          {% if bs_pick != blank and bs_pick.products.size > 0 %}
            <div class="bs-product-grid bs-v4-finder__products">
              {% for product in bs_pick.products limit: 4 %}{% render 'product-card', product: product %}{% endfor %}
            </div>
          {% else %}
            <div class="bs-v4-finder__empty"><span aria-hidden="true">✧</span><p>No products available in this selection yet.</p><a href="{{ routes.all_products_collection_url }}">Explore all available products ↗</a></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Find your perfect match","settings":[{"type":"text","id":"heading","label":"Heading","default":"What are you shopping for?"},{"type":"textarea","id":"intro","label":"Intro","default":"Pick an interest to discover items available in our store."}],"blocks":[{"type":"interest","name":"Shopping interest","settings":[{"type":"text","id":"label","label":"Label","default":"For Pets"},{"type":"text","id":"symbol","label":"Symbol","default":"♡"},{"type":"collection","id":"collection","label":"Collection (optional)"},{"type":"select","id":"fallback","label":"Default collection","default":"pets","options":[{"value":"pets","label":"Pet Supplies"},{"value":"home","label":"Home & Living"},{"value":"beauty","label":"Beauty & Care"},{"value":"gadgets","label":"Tech & Gadgets"},{"value":"fashion","label":"Fashion"},{"value":"none","label":"No fallback"}]}]}],"max_blocks":8,"presets":[{"name":"Find your perfect match","blocks":[{"type":"interest","settings":{"label":"For Pets","symbol":"♡","fallback":"pets"}},{"type":"interest","settings":{"label":"For Home","symbol":"⌂","fallback":"home"}},{"type":"interest","settings":{"label":"For Beauty","symbol":"✦","fallback":"beauty"}},{"type":"interest","settings":{"label":"For Gadgets","symbol":"◫","fallback":"gadgets"}},{"type":"interest","settings":{"label":"For Fashion","symbol":"◇","fallback":"fashion"}}]}]}
{% endschema %}