{% if section.settings.before_image != blank and section.settings.after_image != blank %}
<section class="bs-section bs-v4-comparison" aria-label="{{ section.settings.heading | escape }}">
  <div class="bs-shell">
    <div class="bs-v4-heading"><span class="bs-v4-eyebrow">SEE THE DIFFERENCE</span><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.intro != blank %}<p>{{ section.settings.intro | escape }}</p>{% endif %}</div>
    <div class="bs-v4-compare" data-bs-v4-compare style="--bs-v4-reveal:50%">
      <div class="bs-v4-compare__images">
        {{ section.settings.after_image | image_url: width: 1400 | image_tag: loading: 'lazy', decoding: 'async', widths: '450,700,1000,1400', sizes: '(max-width: 749px) 94vw, 900px', alt: section.settings.after_label, class: 'bs-v4-compare__after' }}
        {{ section.settings.before_image | image_url: width: 1400 | image_tag: loading: 'lazy', decoding: 'async', widths: '450,700,1000,1400', sizes: '(max-width: 749px) 94vw, 900px', alt: section.settings.before_label, class: 'bs-v4-compare__before' }}
        <span class="bs-v4-compare__label bs-v4-compare__label--before">{{ section.settings.before_label | escape }}</span>
        <span class="bs-v4-compare__label bs-v4-compare__label--after">{{ section.settings.after_label | escape }}</span>
        <span class="bs-v4-compare__handle" aria-hidden="true"><span>↔</span></span>
      </div>
      <label class="bs-v4-compare__slider-label" for="BsCompare-{{ section.id }}">Compare before and after images</label>
      <input id="BsCompare-{{ section.id }}" class="bs-v4-compare__slider" type="range" min="0" max="100" value="50" step="1" data-bs-v4-compare-range aria-valuetext="50% before image">
    </div>
  </div>
</section>
{% elsif request.design_mode %}
<section class="bs-section"><div class="bs-shell bs-v4-config-hint"><h2>Before & After</h2><p>Select both real before and after images in section settings. This block stays hidden from customers until then.</p></div></section>
{% endif %}
{% schema %}
{"name":"Before and after","settings":[{"type":"text","id":"heading","label":"Heading","default":"See the difference"},{"type":"textarea","id":"intro","label":"Intro","default":"Move the slider to compare genuine product images."},{"type":"image_picker","id":"before_image","label":"Real before image"},{"type":"image_picker","id":"after_image","label":"Real after image"},{"type":"text","id":"before_label","label":"Before label","default":"Before"},{"type":"text","id":"after_label","label":"After label","default":"After"}],"presets":[{"name":"Before and after"}]}
{% endschema %}