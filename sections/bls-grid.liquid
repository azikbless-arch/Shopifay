{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign skip = section.settings.skip
  assign extra = source.products.size | minus: skip
-%}
{%- if extra > 0 -%}
<section class="bls-block" id="more">
  <div class="bls-wrap">
    <div class="bls-panel bls-panel--smoke bls-reveal">
      <div class="bls-shop__top">
        <div class="bls-shop__title">
          {%- if section.settings.label != blank -%}<p class="bls-label">{{ section.settings.label | escape }}</p>{%- endif -%}
          <h2 class="bls-h2">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      <div class="bls-grid">
        {%- for product in source.products limit: section.settings.products_to_show offset: skip -%}
          <a class="bls-item" href="{{ product.url }}">
            <span class="bls-item__media{% if section.settings.blend %} bls-shot{% endif %}">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title, widths: '240, 400, 600, 800', sizes: '(max-width: 700px) 50vw, (max-width: 1040px) 33vw, 290px' }}
              {%- endif -%}
            </span>
            <span class="bls-item__info">
              {%- if product.type != blank -%}<span class="bls-item__kind">{{ product.type | escape }}</span>{%- endif -%}
              <span class="bls-item__title">{{ product.title | escape }}</span>
              <span class="bls-item__price">
                {%- if product.price_varies -%}From {% endif -%}
                {{ product.price | money }}
                {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
              </span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Glass product grid",
  "settings": [
    {"type": "text", "id": "label", "label": "Small label", "default": "More"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "More finds"},
    {"type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products."},
    {"type": "range", "id": "skip", "label": "Skip the first products", "info": "The storefront above already shows the first three.", "min": 0, "max": 6, "step": 1, "default": 3},
    {"type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8},
    {"type": "checkbox", "id": "blend", "label": "Blend white product photo backgrounds into the card", "default": true}
  ],
  "presets": [{"name": "Glass product grid"}]
}
{% endschema %}
