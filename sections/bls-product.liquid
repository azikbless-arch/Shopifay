{%- liquid
  assign current = product.selected_or_first_available_variant
  assign multi = false
  unless product.has_only_default_variant
    assign multi = true
  endunless
  assign on_sale = false
  if current.compare_at_price > current.price
    assign on_sale = true
  endif
  assign first_media = current.featured_media | default: product.featured_media
  assign nimg = 0
  assign first_idx = 0
  for m in product.media
    if m.media_type == 'image'
      if m.id == first_media.id
        assign first_idx = nimg
      endif
      assign nimg = nimg | plus: 1
    endif
  endfor
-%}
<section class="pg px" data-pgp data-product-id="{{ product.id }}">
<div class="px-wrap">
<div class="px-grid">

<div class="px-top px-stage{% if section.settings.blend %} bls-shot{% endif %}" data-px-stage data-first="{{ first_idx }}">
<div class="px-track" data-px-track>
{%- for m in product.media -%}
{%- if m.media_type == 'image' -%}
<div class="px-s" data-media-id="{{ m.id }}">
{%- if forloop.first -%}
{{ m | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', alt: m.alt | default: product.title, widths: '500, 750, 1000, 1100', sizes: '(max-width: 900px) 100vw, 600px' }}
{%- else -%}
{{ m | image_url: width: 1100 | image_tag: loading: 'lazy', alt: m.alt | default: product.title, widths: '500, 750, 1000, 1100', sizes: '(max-width: 900px) 100vw, 600px' }}
{%- endif -%}
</div>
{%- endif -%}
{%- endfor -%}
{%- if nimg == 0 -%}<div class="px-s"><div class="px-noimg">{{ shop.name | escape }}</div></div>{%- endif -%}
</div>
{%- if on_sale -%}<span class="pg-sale px-sale" data-pgp-sale>-{{ current.compare_at_price | minus: current.price | times: 100 | divided_by: current.compare_at_price }}%</span>{%- endif -%}
<div class="px-act"></div>
{%- if nimg > 1 -%}
<div class="px-dots" data-px-dots aria-hidden="true">{%- for i in (1..nimg) -%}<i></i>{%- endfor -%}</div>
{%- endif -%}
</div>

<div class="px-info">
<h1 class="px-title">{{ product.title | escape }}</h1>
<div class="px-price"><b data-pgp-now>{{ current.price | money }}</b><s data-pgp-was{% unless on_sale %} hidden{% endunless %}>{{ current.compare_at_price | money }}</s></div>

{%- form 'product', product, class: 'px-buy', novalidate: 'novalidate', id: 'PgpForm' -%}
<input type="hidden" name="id" value="{{ current.id }}" data-pgp-id>
<input type="hidden" name="quantity" value="1">
{%- if multi -%}
<div class="px-opts">
{%- for option in product.options_with_values -%}
<fieldset class="pgp__opt" data-pgp-opt data-pos="{{ forloop.index }}">
<legend class="pg-label">{{ option.name | escape }}</legend>
<div class="pgp__vals">
{%- for value in option.values -%}
<label class="pgp__val">
<input type="radio" name="pgp-opt-{{ forloop.parentloop.index }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
<span>{{ value | escape }}</span>
</label>
{%- endfor -%}
</div>
</fieldset>
{%- endfor -%}
</div>
{%- endif -%}
<button class="px-add" type="submit" name="add" data-pgp-add{% unless current.available %} disabled{% endunless %}>
<span data-pgp-addtext>{% if current.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</span>
</button>
{%- if section.settings.show_dynamic_checkout -%}<div class="pgp__dyn">{{ form | payment_button }}</div>{%- endif -%}
{%- endform -%}

<div class="px-more">
{%- if product.description != blank -%}
<details class="px-d"><summary>{{ 'product.description' | t }}</summary><div class="pg-rte">{{ product.description }}</div></details>
{%- endif -%}
<details class="px-d"><summary>{{ 'pg.product.returns' | t }}</summary><div class="pg-rte"><p>{{ 'pg.product.ship' | t }}. {{ 'pg.product.secure' | t }}.</p></div></details>
</div>
</div>

</div>

{%- if section.settings.show_related -%}
<div class="pgp__related" data-pgp-related data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=8&intent=related">
{%- if recommendations.performed and recommendations.products_count > 0 -%}
<div class="pg-head" style="margin-top:46px"><div><p class="pg-eyebrow">{{ 'pg.product.more' | t }}</p><h2 class="pg-h1" style="font-size:clamp(24px,3vw,34px)">{{ 'product.recommendations' | t }}</h2></div></div>
<div class="bls-grid">
{%- for rec in recommendations.products limit: 8 -%}{%- render 'bls-card', product: rec, blend: true, eager: false -%}{%- endfor -%}
</div>
{%- endif -%}
</div>
{%- endif -%}
</div>

<div class="px-bar" data-px-bar>
<div class="px-bar__p"><b data-pgp-barprice>{{ current.price | money }}</b><s data-pgp-barwas{% unless on_sale %} hidden{% endunless %}>{{ current.compare_at_price | money }}</s></div>
<button class="px-add px-add--bar" type="submit" form="PgpForm" name="add" data-pgp-add2{% unless current.available %} disabled{% endunless %}>
<span data-pgp-addtext2>{% if current.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</span>
</button>
</div>
<script type="application/json" data-pgp-variants>{{ product.variants | json }}</script>
</section>
{%- render 'bls-px-style' -%}
{%- render 'bls-px-js' -%}
{% schema %}
{
  "name": "Glass product",
  "settings": [
    {"type": "checkbox", "id": "blend", "label": "Blend white photo backgrounds into a soft studio backdrop", "default": true},
    {"type": "checkbox", "id": "show_vendor", "label": "Show the brand above the title", "default": false},
    {"type": "checkbox", "id": "show_dynamic_checkout", "label": "Show the quick checkout buttons (Shop Pay, Apple Pay)", "default": false},
    {"type": "checkbox", "id": "show_related", "label": "Show similar products at the bottom", "default": true}
  ]
}
{% endschema %}