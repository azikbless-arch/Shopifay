<section class="bs-section bs-categories">
  <div class="bs-shell">
    <div class="bs-section-head"><h2>{{ section.settings.heading }}</h2><a href="{{ routes.collections_url }}">{{ section.settings.view_all }} →</a></div>
    <div class="bs-category-grid">
      {% for block in section.blocks %}
        {% assign chosen_collection = block.settings.collection %}
        <a class="bs-category-card bs-cat-{{ block.settings.tone }}" href="{% if chosen_collection != blank %}{{ chosen_collection.url }}{% else %}{{ routes.collections_url }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="bs-category-card__image">
            {% if chosen_collection != blank and chosen_collection.featured_image != blank %}
              {{ chosen_collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.label }}
            {% elsif chosen_collection != blank and chosen_collection.products.first.featured_image != blank %}
              {{ chosen_collection.products.first.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.label }}
            {% else %}
              {% case block.settings.fallback_image %}
                {% when 'home' %}<img src="https://cdn.shopify.com/s/files/1/0743/7434/8844/files/blesshop-premium-v13-category-home.jpg?v=1791445300" alt="{{ block.settings.label | escape }}" loading="lazy" decoding="async" width="600" height="450">
                {% when 'pets' %}<img src="https://cdn.shopify.com/s/files/1/0743/7434/8844/files/blesshop-premium-v13-category-pets.jpg?v=1791445306" alt="{{ block.settings.label | escape }}" loading="lazy" decoding="async" width="600" height="450">
                {% when 'car' %}<img src="https://cdn.shopify.com/s/files/1/0743/7434/8844/files/blesshop-premium-v13-category-car.jpg?v=1791445321" alt="{{ block.settings.label | escape }}" loading="lazy" decoding="async" width="600" height="450">
                {% when 'beauty' %}<img src="https://cdn.shopify.com/s/files/1/0743/7434/8844/files/blesshop-premium-v13-category-beauty.jpg?v=1791445326" alt="{{ block.settings.label | escape }}" loading="lazy" decoding="async" width="600" height="450">
                {% when 'travel' %}<img src="https://cdn.shopify.com/s/files/1/0743/7434/8844/files/blesshop-premium-v13-category-travel.jpg?v=1791445334" alt="{{ block.settings.label | escape }}" loading="lazy" decoding="async" width="600" height="450">
                {% when 'gadgets' %}<img src="https://cdn.shopify.com/s/files/1/0743/7434/8844/files/blesshop-premium-v13-category-gadgets.jpg?v=1791445342" alt="{{ block.settings.label | escape }}" loading="lazy" decoding="async" width="600" height="450">
                {% else %}<span class="bs-category-symbol">{{ block.settings.symbol }}</span>
              {% endcase %}
              <span class="bs-category-bubble bs-category-bubble--1"></span><span class="bs-category-bubble bs-category-bubble--2"></span>
            {% endif %}
          </div>
          <div class="bs-category-card__foot"><strong>{{ block.settings.label }}</strong><span>›</span></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shop by category",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Shop by Category"},
    {"type":"text","id":"view_all","label":"View all label","default":"View All Categories"}
  ],
  "blocks": [
    {"type":"category","name":"Category","settings":[
      {"type":"collection","id":"collection","label":"Collection"},
      {"type":"text","id":"label","label":"Label","default":"Home & Living"},
      {"type":"text","id":"symbol","label":"Fallback symbol","default":"⌂"},
      {"type":"select","id":"fallback_image","label":"Fallback image","default":"home","options":[{"value":"home","label":"Home"},{"value":"pets","label":"Pets"},{"value":"car","label":"Car"},{"value":"beauty","label":"Beauty"},{"value":"travel","label":"Travel"},{"value":"gadgets","label":"Gadgets"},{"value":"symbol","label":"Symbol only"}]},
      {"type":"select","id":"tone","label":"Color tone","default":"blush","options":[{"value":"blush","label":"Blush"},{"value":"lavender","label":"Lavender"},{"value":"cream","label":"Cream"},{"value":"sage","label":"Sage"}]}
    ]}
  ],
  "presets": [{"name":"Shop by category","blocks":[
    {"type":"category","settings":{"label":"Home & Living","symbol":"⌂","fallback_image":"home","tone":"cream"}},
    {"type":"category","settings":{"label":"Pets","symbol":"♡","fallback_image":"pets","tone":"blush"}},
    {"type":"category","settings":{"label":"Car","symbol":"◉","fallback_image":"car","tone":"lavender"}},
    {"type":"category","settings":{"label":"Beauty","symbol":"✦","fallback_image":"beauty","tone":"blush"}},
    {"type":"category","settings":{"label":"Travel","symbol":"✈","fallback_image":"travel","tone":"cream"}},
    {"type":"category","settings":{"label":"Gadgets","symbol":"◫","fallback_image":"gadgets","tone":"lavender"}}
  ]}]
}
{% endschema %}
