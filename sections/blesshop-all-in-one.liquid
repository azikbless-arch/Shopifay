{%- assign scene_count = section.blocks.size | at_least: 1 -%}
<section id="bsh-{{ section.id }}" class="bsh" style="--n:{{ scene_count }};--ov:{{ section.settings.overlay | divided_by: 100.0 }}">
  <div class="bsh__sticky">
    {%- for b in section.blocks -%}
      <div class="bsh__scene{% if forloop.first %} is-active{% endif %}" {{ b.shopify_attributes }}>
        {%- if b.settings.image != blank -%}
          {%- if forloop.first -%}
            {{ b.settings.image | image_url: width: 2560 | image_tag: widths: '750,1100,1500,1920,2560', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'bsh__img' }}
          {%- else -%}
            {{ b.settings.image | image_url: width: 2560 | image_tag: widths: '750,1100,1500,1920,2560', sizes: '100vw', loading: 'lazy', class: 'bsh__img' }}
          {%- endif -%}
        {%- endif -%}
        <div class="bsh__txt">
          {%- if b.settings.eyebrow != blank -%}<p class="bsh__eyebrow">{{ b.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2>{{ b.settings.heading | escape }}</h2>
          {%- if b.settings.text != blank -%}<p>{{ b.settings.text | escape }}</p>{%- endif -%}
          {%- if b.settings.link != blank -%}<a class="bsh__glass-btn" href="{{ b.settings.link }}">{{ b.settings.btn | escape }} →</a>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
<style>
#bsh-{{ section.id }}{height:calc(var(--n)*100svh);position:relative}
#bsh-{{ section.id }} .bsh__sticky{position:sticky;top:0;height:100svh;overflow:hidden;background:#0b1a33}
#bsh-{{ section.id }} .bsh__scene{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .85s ease,visibility .85s ease}
#bsh-{{ section.id }} .bsh__scene.is-active{opacity:1;visibility:visible}
#bsh-{{ section.id }} .bsh__img{width:100%;height:100%;object-fit:cover;transform:scale(1.05);transition:transform 5s ease}
#bsh-{{ section.id }} .bsh__scene.is-active .bsh__img{transform:scale(1)}
#bsh-{{ section.id }} .bsh__scene:after{content:"";pointer-events:none;position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,15,35,var(--ov)),transparent 75%)}
#bsh-{{ section.id }} .bsh__txt{position:absolute;z-index:2;left:clamp(20px,6vw,100px);bottom:clamp(50px,14svh,160px);max-width:min(560px,88vw);color:white}
#bsh-{{ section.id }} .bsh__txt h2{color:inherit;font-size:clamp(2.2rem,6vw,5rem);margin:.2em 0;line-height:1.08}
#bsh-{{ section.id }} .bsh__eyebrow{letter-spacing:.22em;font-size:.75rem;text-transform:uppercase}
#bsh-{{ section.id }} .bsh__glass-btn{display:inline-flex;margin-top:1rem;padding:.85rem 1.5rem;border-radius:999px;color:#fff;text-decoration:none;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.45);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);transition:background .3s}
#bsh-{{ section.id }} .bsh__glass-btn:hover{background:rgba(255,255,255,.27)}
@media(max-width:749px){#bsh-{{ section.id }} .bsh__txt{left:6vw;bottom:12svh}#bsh-{{ section.id }} .bsh__scene:after{background:linear-gradient(0deg,rgba(5,15,35,var(--ov)),transparent 85%)}}
@media(prefers-reduced-motion:reduce){#bsh-{{ section.id }} .bsh__scene,#bsh-{{ section.id }} .bsh__img{transition:none}}
</style>
<script>
(function(){
  const root=document.getElementById('bsh-{{ section.id }}');
  if(!root || root.dataset.bshReady) return;
  root.dataset.bshReady='1';
  const scenes=Array.from(root.querySelectorAll('.bsh__scene'));
  if(!scenes.length) return;
  let active=0, ticking=false;
  function update(){
    ticking=false;
    const rect=root.getBoundingClientRect();
    const span=Math.max(1,rect.height-window.innerHeight);
    const progress=Math.max(0,Math.min(0.999,-rect.top/span));
    const next=Math.min(scenes.length-1,Math.floor(progress*scenes.length));
    if(next!==active){scenes[active].classList.remove('is-active');scenes[next].classList.add('is-active');active=next;}
  }
  function onScroll(){if(!ticking){ticking=true;requestAnimationFrame(update);}}
  window.addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('resize',onScroll,{passive:true});
  update();
})();
</script>
{% schema %}
{"name":"BLESSHOP Scroll Hero","settings":[{"type":"range","id":"overlay","label":"Затемнение %","min":0,"max":80,"step":5,"default":40}],"blocks":[{"type":"scene","name":"Сцена","settings":[{"type":"image_picker","id":"image","label":"Фото"},{"type":"text","id":"eyebrow","label":"Надпись сверху","default":"HOME"},{"type":"text","id":"heading","label":"Заголовок","default":"Home & Living"},{"type":"textarea","id":"text","label":"Текст"},{"type":"text","id":"btn","label":"Кнопка","default":"Explore"},{"type":"url","id":"link","label":"Ссылка"}]}],"presets":[{"name":"BLESSHOP Scroll Hero","blocks":[{"type":"scene"},{"type":"scene"},{"type":"scene"},{"type":"scene"}]}]}
{% endschema %}