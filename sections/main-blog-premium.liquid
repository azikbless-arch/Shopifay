<section class="bs-section">
  <div class="bs-shell">
    <div class="bs-section-head"><h1>{{ blog.title }}</h1></div>
    {% paginate blog.articles by 12 %}
      <div class="bs-blog-grid">
        {% for article in blog.articles %}
          <article class="bs-article-card">
            <a href="{{ article.url }}">
              {% if article.image %}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,600,800,1000', alt: article.title }}{% endif %}
            </a>
            <div class="bs-article-card__body">
              <p class="bs-eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</p>
              <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              <a class="bs-mini-btn" href="{{ article.url }}">Read more →</a>
            </div>
          </article>
        {% else %}
          <p>No articles yet.</p>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav class="bs-pagination">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}{"name":"Premium blog","settings":[],"presets":[{"name":"Premium blog"}]}{% endschema %}