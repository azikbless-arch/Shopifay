{%- capture nav_links -%}
  <button type="button" class="bls-navbtn" data-bls-catalog aria-haspopup="dialog">{{ 'bls.catalog' | t }}</button>
  <a href="{{ routes.root_url }}#deals" data-ab-deals>{{ 'bls.deals' | t }}</a>
  {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title | escape }}</a>
    {%- endfor -%}
  {%- else -%}
    <a href="{{ routes.all_products_collection_url }}">{{ 'bls.shop_all' | t }}</a>
  {%- endif -%}
{%- endcapture -%}
<header class="bls-header">
  <div class="bls-wrap">
    <div class="bls-bar">
      <details class="bls-menu">
        <summary class="bls-round bls-round--glass" aria-label="{{ 'bls.menu' | t }}">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16"></path><path d="M4 16h16"></path></svg>
        </summary>
        <nav class="bls-menu__panel" aria-label="{{ 'bls.menu' | t }}">
          {{ nav_links }}
          <a href="{{ routes.search_url }}">{{ 'bls.search' | t }}</a>
          <a href="{{ routes.account_url }}">{{ 'bls.profile' | t }}</a>
        </nav>
      </details>
      <a class="bls-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <span class="bls-logo__dot" aria-hidden="true"></span>
        {{ settings.brand_name | default: shop.name | upcase | escape }}
      </a>
      <nav class="bls-nav" aria-label="{{ 'bls.menu' | t }}">{{ nav_links }}</nav>
      <form class="bls-search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" placeholder="{{ 'bls.search' | t }}" aria-label="{{ 'bls.search' | t }}">
        <button class="bls-round" type="submit" aria-label="{{ 'bls.search' | t }}">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path></svg>
        </button>
      </form>
      <div class="bls-actions">
        <a class="bls-round bls-round--glass bls-searchlink" href="{{ routes.search_url }}" aria-label="{{ 'bls.search' | t }}">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path></svg>
        </a>
        {%- if localization.available_languages.size > 1 -%}
          {%- form 'localization', class: 'bls-lang' -%}
            {%- for lang in localization.available_languages -%}
              {%- unless lang.iso_code == localization.language.iso_code -%}
                {%- if forloop.index0 < 2 -%}
                  <button class="bls-round bls-round--glass bls-langbtn" type="submit" name="language_code" value="{{ lang.iso_code }}" lang="{{ lang.iso_code }}" aria-label="{{ lang.endonym_name | escape }}">{{ lang.iso_code | upcase }}</button>
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endform -%}
        {%- endif -%}
        <a class="bls-round bls-round--glass bls-account" href="{{ routes.account_url }}" aria-label="{{ 'bls.profile' | t }}">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"></circle><path d="M5 20c.8-3.6 3.6-5.4 7-5.4s6.2 1.8 7 5.4"></path></svg>
        </a>
        <a class="bls-round bls-round--glass bls-cart" href="{{ routes.cart_url }}" aria-label="{{ 'bls.cart' | t }}">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6L5 8z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg>
          {%- if cart.item_count > 0 -%}<span class="bls-cart-count">{{ cart.item_count }}</span>{%- endif -%}
        </a>
      </div>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "Glass header",
  "settings": [
    {"type": "link_list", "id": "menu", "label": "Menu", "info": "Leave empty to list Shop all. Catalog and Deals are always first. Words in the menu come from the language files."}
  ]
}
{% endschema %}
