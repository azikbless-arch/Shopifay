{% assign bs_has_videos = false %}{% for block in section.blocks %}{% if block.settings.video != blank %}{% assign bs_has_videos = true %}{% endif %}{% endfor %}
{% if bs_has_videos %}
<section class="bs-section bs-v4-videos">
  <div class="bs-shell">
    <div class="bs-v4-heading"><span class="bs-v4-eyebrow">REAL PRODUCT VIDEOS</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p></div>
    <div class="bs-v4-videos__grid">
      {% for block in section.blocks %}{% if block.settings.video != blank %}
      <article class="bs-v4-video-card" {{ block.shopify_attributes }}>
        <div class="bs-v4-video-card__media">{{ block.settings.video | video_tag: controls: true, autoplay: false, loop: false, preload: 'metadata', image_size: '850x' }}</div>
        {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
        {% if block.settings.product != blank %}<a href="{{ block.settings.product.url }}">Explore {{ block.settings.product.title | escape }} ↗</a>{% endif %}
      </article>{% endif %}{% endfor %}
    </div>
  </div>
</section>
{% elsif request.design_mode %}
<section class="bs-section"><div class="bs-shell bs-v4-config-hint"><h2>Product videos</h2><p>Add actual Shopify-hosted product videos in the section blocks to show this section to customers.</p></div></section>
{% endif %}
{% schema %}
{"name":"Product video showcase","settings":[{"type":"text","id":"heading","label":"Heading","default":"See it in action"},{"type":"textarea","id":"intro","label":"Intro","default":"Watch real videos of the products you love."}],"blocks":[{"type":"clip","name":"Real product video","settings":[{"type":"video","id":"video","label":"Product video"},{"type":"text","id":"heading","label":"Title","default":"Watch the product"},{"type":"product","id":"product","label":"Link to product"}]}],"max_blocks":4,"presets":[{"name":"Product video showcase","blocks":[{"type":"clip"}]}]}
{% endschema %}