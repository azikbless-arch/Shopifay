<section class="bs-section">
  <div class="bs-shell">
    <div class="bs-section-head"><h2>{{ section.settings.heading }}</h2></div>
    <div class="bs-press-grid">
      {% for block in section.blocks %}
        <div class="bs-press-item" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.name }}</strong>
          <p>{{ block.settings.quote }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Press mentions",
  "settings":[{"type":"text","id":"heading","label":"Heading","default":"As seen & shared"}],
  "blocks":[
    {"type":"mention","name":"Mention","settings":[
      {"type":"text","id":"name","label":"Publication or creator","default":"Featured"},
      {"type":"textarea","id":"quote","label":"Short quote","default":"A useful find worth talking about."}
    ]}
  ],
  "max_blocks":8,
  "presets":[{"name":"Press mentions","blocks":[{"type":"mention"},{"type":"mention"},{"type":"mention"},{"type":"mention"}]}]
}
{% endschema %}