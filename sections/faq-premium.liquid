<section class="bs-section">
  <div class="bs-shell bs-faq">
    <div class="bs-section-head"><h1>{{ section.settings.heading }}</h1></div>
    {% if section.settings.intro != blank %}<p>{{ section.settings.intro }}</p>{% endif %}
    {% for block in section.blocks %}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div>{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"FAQ",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"},
    {"type":"textarea","id":"intro","label":"Intro","default":"Quick answers about orders, delivery, returns and products."}
  ],
  "blocks":[
    {"type":"item","name":"Question","settings":[
      {"type":"text","id":"question","label":"Question","default":"How long does shipping take?"},
      {"type":"richtext","id":"answer","label":"Answer","default":"<p>Delivery estimates are shown at checkout and tracking is sent when available.</p>"}
    ]}
  ],
  "presets":[{"name":"FAQ","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}