{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign limit = section.settings.products_to_show
  assign shown = 0
  assign ends = section.settings.ends | strip
-%}
{%- capture arrow -%}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg>{%- endcapture -%}
{%- capture plus -%}<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>{%- endcapture -%}
<section class="gl-block" id="deals" aria-labelledby="Deals-{{ section.id }}">
  {%- render 'bls-glass' -%}
  <div class="gl-wrap">
    <div class="gl-head">
      <div class="gl-title">
        {%- if section.settings.label != blank -%}<p class="gl-eyebrow">{{ section.settings.label | escape }}</p>{%- endif -%}
        <h2 class="gl-h2" id="Deals-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if ends != blank -%}
        <div class="dl-timer gl-pill gl-glass" data-deals-end="{{ ends | escape }}" hidden><span class="dl-timer__label">{{ section.settings.timer_label | escape }}</span><b data-deals-left></b></div>
      {%- endif -%}
    </div>
    <div class="gl-railwrap" data-gl-rails>
      <div class="gl-rail gl-prods" data-gl-rail tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
        {%- for p in source.products limit: 60 -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- if p.compare_at_price > p.price and p.available -%}
            {%- liquid
              assign shown = shown | plus: 1
              assign off = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price
              assign load = 'lazy'
              if shown <= 3
                assign load = 'eager'
              endif
            -%}
            <article class="gl-prod gl-pane">
              <a class="gl-prod__media{% if section.settings.blend %} bls-shot{% endif %}" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
                {%- if p.featured_image != blank -%}
                  {{ p.featured_image | image_url: width: 600 | image_tag: loading: load, alt: p.title, widths: '300, 450, 600', sizes: '(max-width: 700px) 45vw, 240px' }}
                {%- endif -%}
                <span class="gl-flag gl-glass">-{{ off }}%</span>
              </a>
              <div class="gl-prod__body">
                <a class="gl-prod__title" href="{{ p.url }}">{{ p.title | escape }}</a>
                <div class="gl-prod__row">
                  <span class="gl-price">{{ p.price | money }}<s>{{ p.compare_at_price | money }}</s></span>
                  {%- if p.variants.size == 1 -%}
                    {%- form 'product', p, class: 'gl-add' -%}
                      <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                      <button class="gl-pill gl-pill--gold gl-glass" type="submit" aria-label="{{ section.settings.add_label | escape }}: {{ p.title | escape }}">{{ plus }}{{ section.settings.add_label | escape }}</button>
                    {%- endform -%}
                  {%- else -%}
                    <a class="gl-pill gl-pill--gold gl-glass" href="{{ p.url }}">{{ section.settings.options_label | escape }}</a>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
        {%- if shown > 0 -%}
          <a class="gl-end gl-pane" href="{% if section.settings.collection != blank %}{{ section.settings.collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
            <span class="gl-end__text">{{ section.settings.end_heading | escape }}</span>
            <span class="gl-go" aria-hidden="true">{{ arrow }}</span>
          </a>
        {%- else -%}
          <div class="gl-empty gl-pane">
            <span class="gl-end__text">{{ section.settings.empty_heading | escape }}</span>
            <a class="gl-pill gl-glass" href="{{ routes.all_products_collection_url }}">{{ section.settings.empty_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
      <button type="button" class="gl-nav gl-nav--prev gl-glass" data-gl-prev aria-label="Previous"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg></button>
      <button type="button" class="gl-nav gl-nav--next gl-glass" data-gl-next aria-label="Next"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></button>
    </div>
  </div>
</section>
<style>
#deals .gl-flag{background:linear-gradient(135deg,rgba(255,120,96,.9),rgba(224,70,60,.8));color:#fff;border:0;text-shadow:0 1px 1px rgba(80,10,10,.3)}
#deals .gl-flag::before{content:none}
#deals .gl-price{color:var(--bls-gold,#E3B458)}
#deals .gl-price s{color:inherit}
.dl-timer{gap:8px;cursor:default;font-variant-numeric:tabular-nums}
.dl-timer[hidden]{display:none}
.dl-timer__label{opacity:.78;font-weight:600}
.dl-timer b{font-weight:700;letter-spacing:.02em}
body[data-skin="home"] #deals .gl-price{color:#8E5F33}
</style>
<script>
(function(){
  function run(root){
    var l=(root||document).querySelectorAll('[data-deals-end]');
    for(var i=0;i<l.length;i++){(function(el){
      if(el.__dl)return;el.__dl=1;
      var end=new Date(el.getAttribute('data-deals-end')).getTime();
      var out=el.querySelector('[data-deals-left]');
      if(!end||!out)return;
      function tick(){
        var s=Math.floor((end-Date.now())/1000);
        if(s<=0){el.hidden=true;return;}
        var d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60),c=s%60;
        function z(n){return n<10?'0'+n:''+n;}
        out.textContent=(d>0?d+'d ':'')+z(h)+':'+z(m)+':'+z(c);
        el.hidden=false;
        setTimeout(tick,1000);
      }
      tick();
    })(l[i]);}
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){run();});else run();
  document.addEventListener('shopify:section:load',function(e){run(e.target);});
})();
</script>
{% schema %}
{
  "name": "Glass deals row",
  "settings": [
    {"type": "text", "id": "label", "label": "Small label", "default": "Offers"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Deals of the day"},
    {"type": "collection", "id": "collection", "label": "Collection with deals", "info": "Leave empty to pick every product that has a crossed-out price from the whole store."},
    {"type": "range", "id": "products_to_show", "label": "Products in a row", "min": 2, "max": 16, "step": 1, "default": 10},
    {"type": "text", "id": "ends", "label": "Offer ends", "info": "Date and time like 2026-12-31T23:59. Leave empty to hide the countdown."},
    {"type": "text", "id": "timer_label", "label": "Countdown text", "default": "Ends in"},
    {"type": "checkbox", "id": "blend", "label": "Blend white product photo backgrounds into the card", "default": true},
    {"type": "text", "id": "add_label", "label": "Add to cart", "default": "Add"},
    {"type": "text", "id": "options_label", "label": "Product with options", "default": "Options"},
    {"type": "text", "id": "end_heading", "label": "Last card", "default": "All offers"},
    {"type": "text", "id": "empty_heading", "label": "When there are no deals yet", "default": "New offers are on the way"},
    {"type": "text", "id": "empty_label", "label": "Button when empty", "default": "Browse the shop"}
  ],
  "presets": [{"name": "Glass deals row"}]
}
{% endschema %}
