<section class="pg">
  <div class="pg-wrap">
    <div class="pg-head">
      <div><p class="pg-eyebrow">{{ 'cart.your_bag' | t }}</p><h1 class="pg-h1">{{ 'general.cart' | t }}</h1></div>
      <a class="pg-link" href="{{ routes.all_products_collection_url }}">{{ 'pg.cart.continue' | t }} &rarr;</a>
    </div>
    <div data-pg-cart data-section="{{ section.id }}">
      {%- if cart.item_count == 0 -%}
        <div class="pg-panel pg-empty">
          <span class="pg-empty__mark"><svg aria-hidden="true" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6L5 8z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg></span>
          <h2 class="bls-h2">{{ 'cart.empty' | t }}</h2>
          <p>{{ 'pg.cart.empty_text' | t }}</p>
          <a class="pg-btn" href="{{ routes.all_products_collection_url }}">{{ 'bls.shop_all' | t }}</a>
        </div>
      {%- else -%}
        <div class="pgc">
          <div class="pgc__list">
            {%- for item in cart.items -%}
              <div class="pg-panel pgc__line">
                <a class="pgc__pic" href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}</a>
                <div class="pgc__info">
                  <a class="pgc__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}<span class="pgc__var">{{ item.variant.title | escape }}</span>{%- endunless -%}
                  {%- for p in item.properties -%}{%- unless p.last == blank or p.first contains '_' -%}<span class="pgc__var">{{ p.first | escape }}: {{ p.last | escape }}</span>{%- endunless -%}{%- endfor -%}
                  <span class="pgc__unit">{{ item.final_price | money }}{% if item.original_price > item.final_price %} <s>{{ item.original_price | money }}</s>{% endif %}</span>
                  {%- for allocation in item.line_level_discount_allocations -%}<span class="pg-sale" style="align-self:flex-start">{{ allocation.discount_application.title | escape }}</span>{%- endfor -%}
                </div>
                <div class="pgc__side">
                  <strong class="pgc__total">{{ item.final_line_price | money }}</strong>
                  <div class="pg-qty">
                    <button type="button" data-cart-change="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'pg.cart.minus' | t }}">&minus;</button>
                    <input type="number" value="{{ item.quantity }}" min="0" data-cart-qty="{{ item.key }}" aria-label="{{ 'product.quantity' | t }}">
                    <button type="button" data-cart-change="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'pg.cart.plus' | t }}">+</button>
                  </div>
                  <button class="cd__rm" type="button" data-cart-change="{{ item.key }}" data-qty="0">{{ 'pg.cart.remove' | t }}</button>
                </div>
              </div>
            {%- endfor -%}
          </div>
          <aside class="pg-panel pgc__sum">
            <h2 class="pgc__sumtitle">{{ 'pg.cart.summary' | t }}</h2>
            <label class="pg-label" for="PgNote">{{ 'cart.order_note' | t }}</label>
            <textarea class="pg-in" id="PgNote" rows="3" data-pg-note placeholder="{{ 'pg.cart.note_ph' | t }}">{{ cart.note }}</textarea>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for d in cart.cart_level_discount_applications -%}<div class="pgc__row"><span>{{ d.title | escape }}</span><span>&minus;{{ d.total_allocated_amount | money }}</span></div>{%- endfor -%}
            {%- endif -%}
            <div class="pgc__row pgc__row--big"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>
            <p class="pgc__fine">{{ 'pg.cart.taxes' | t }}</p>
            <form action="{{ routes.cart_url }}" method="post">
              <button class="pg-btn pg-btn--wide" type="submit" name="checkout">{{ 'cart.checkout' | t }} &rarr;</button>
            </form>
          </aside>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
.pgc{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:18px;align-items:start}
.pgc__list{display:flex;flex-direction:column;gap:12px}
.pgc__line{display:grid;grid-template-columns:104px minmax(0,1fr) auto;gap:16px;align-items:center;padding:12px}
.pgc__pic{display:block;width:104px;height:104px;overflow:hidden;border-radius:18px;background:#0A0C13}
.pgc__pic img{width:100%;height:100%;object-fit:cover}
.pgc__info{display:flex;flex-direction:column;gap:5px;min-width:0}
.pgc__name{font-size:16px;font-weight:600;line-height:1.3}
.pgc__var{font-size:13px;color:var(--bls-muted,#B7BECF)}
.pgc__unit{font-size:14px;color:var(--bls-muted,#B7BECF)}
.pgc__unit s{opacity:.7;margin-left:6px}
.pgc__side{display:flex;flex-direction:column;align-items:flex-end;gap:8px}
.pgc__total{font-size:18px}
.pgc__sum{display:flex;flex-direction:column;gap:12px;position:sticky;top:96px}
.pgc__sumtitle{margin:0 0 4px;font-family:var(--bls-display,'Jost',sans-serif);font-size:24px;font-weight:300}
.pgc__row{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-size:14px}
.pgc__row--big{padding-top:12px;border-top:1px solid rgba(255,255,255,.14);font-size:15px}
.pgc__row--big strong{font-size:26px}
.pgc__fine{margin:0;font-size:12px;color:var(--bls-muted,#B7BECF)}
@media (max-width:900px){.pgc{grid-template-columns:minmax(0,1fr)}.pgc__sum{position:static}}
@media (max-width:560px){.pgc__line{grid-template-columns:78px minmax(0,1fr);gap:12px}.pgc__pic{width:78px;height:78px}.pgc__side{grid-column:1 / -1;flex-direction:row;align-items:center;justify-content:space-between}}
</style>
{% schema %}
{"name": "Glass cart", "settings": []}
{% endschema %}
