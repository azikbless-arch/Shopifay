{%- liquid
  assign url = section.settings.link | default: routes.all_products_collection_url
  assign pic = section.settings.image
  assign shot = false
  if pic == blank and section.settings.use_product
    assign pic = collections.all.products.first.featured_image
    assign shot = true
  endif
-%}
{%- if section.settings.text != blank -%}
<section class="bls-block">
  <div class="bls-wrap">
    <a class="bls-banner bls-reveal" href="{{ url }}">
      <span class="bls-banner__thumb">
        <span class="bls-banner__pic{% if pic != blank and shot %} bls-shot{% endif %}" aria-hidden="true">
          {%- if pic != blank -%}
            {{ pic | image_url: width: 360 | image_tag: loading: 'lazy', alt: '', widths: '180, 360', sizes: '120px' }}
          {%- else -%}
            <span class="bls-artbox bls-artbox--moon"><canvas class="bls-art" data-bls-art="moon"></canvas></span>
          {%- endif -%}
        </span>
        <span class="bls-round bls-round--dark" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"></circle><path d="M20 20l-4.3-4.3"></path><path d="M11 8.5v5"></path><path d="M8.5 11h5"></path></svg></span>
      </span>
      <span class="bls-banner__text">{{ section.settings.text | escape }}</span>
      {%- if section.settings.note != blank -%}<span class="bls-banner__meta">{{ section.settings.note | escape }}</span>{%- endif -%}
      {%- if section.settings.note_2 != blank -%}<span class="bls-banner__meta bls-banner__meta--b">{{ section.settings.note_2 | escape }}</span>{%- endif -%}
      <span class="bls-round bls-round--line bls-banner__go" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18L18 6"></path><path d="M8 6h10v10"></path></svg></span>
    </a>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Glass banner",
  "settings": [
    {"type": "text", "id": "text", "label": "Large text", "default": "New · cosmic finds"},
    {"type": "text", "id": "note", "label": "Small note", "default": "Pet · Home · Fashion"},
    {"type": "text", "id": "note_2", "label": "Second small note", "default": "Shop all"},
    {"type": "url", "id": "link", "label": "Link", "info": "Leave empty to open all products."},
    {"type": "image_picker", "id": "image", "label": "Round picture"},
    {"type": "checkbox", "id": "use_product", "label": "Use the first product photo when no picture is chosen", "default": true}
  ],
  "presets": [{"name": "Glass banner"}]
}
{% endschema %}
