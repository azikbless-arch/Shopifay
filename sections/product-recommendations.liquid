<section class="bs-section bs-recommendations">
  <div class="bs-shell">
    <div class="bs-section-head bs-section-head--compact">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div data-product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}">
      {% if recommendations.performed and recommendations.products_count > 0 %}
        <div class="bs-product-grid bs-product-grid--home">
          {% for product in recommendations.products %}{% render 'product-card', product: product %}{% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Product recommendations",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"You may also like"},
    {"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":8,"step":1,"default":5}
  ],
  "presets":[{"name":"Product recommendations"}]
}
{% endschema %}