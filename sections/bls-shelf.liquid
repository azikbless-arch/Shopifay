{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign shop_url = routes.all_products_collection_url
  if section.settings.collection != blank
    assign shop_url = section.settings.collection.url
  endif
  assign kinds = source.all_types
  assign shown = 0
-%}
{%- capture arrow -%}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg>{%- endcapture -%}
{%- capture plus -%}<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>{%- endcapture -%}
<section class="gl-block" id="{% if section.settings.show_products %}shop{% else %}info{% endif %}" aria-labelledby="GlShop-{{ section.id }}">
  {%- render 'bls-glass' -%}
  <div class="gl-wrap">
    {%- if section.settings.show_products -%}
    <div class="gl-head">
      <div class="gl-title">
        {%- if section.settings.label != blank -%}<p class="gl-eyebrow">{{ section.settings.label | escape }}</p>{%- endif -%}
        <h2 class="gl-h2" id="GlShop-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="gl-chips">
        <a class="gl-pill gl-glass" href="{{ shop_url }}">{{ section.settings.all_label | escape }}</a>
        {%- for kind in kinds limit: 5 -%}
          {%- if kind != blank -%}<a class="gl-pill gl-glass" href="{{ kind | url_for_type }}">{{ kind | escape }}</a>{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="gl-railwrap" data-gl-rails>
      <div class="gl-rail gl-prods" data-gl-rail tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
        {%- for p in source.products limit: section.settings.products_to_show -%}
          {%- liquid
            assign shown = shown | plus: 1
            assign load = 'eager'
            if forloop.index > 4
              assign load = 'lazy'
            endif
          -%}
          <article class="gl-prod gl-pane">
            <a class="gl-prod__media{% if section.settings.blend %} bls-shot{% endif %}" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
              {%- if p.featured_image != blank -%}
                {{ p.featured_image | image_url: width: 600 | image_tag: loading: load, alt: p.title, widths: '300, 450, 600', sizes: '(max-width: 700px) 45vw, 240px' }}
              {%- endif -%}
              {%- if forloop.first and section.settings.flag != blank -%}<span class="gl-flag gl-glass">{{ section.settings.flag | escape }}</span>{%- endif -%}
            </a>
            <div class="gl-prod__body">
              <a class="gl-prod__title" href="{{ p.url }}">{{ p.title | escape }}</a>
              <div class="gl-prod__row">
                <span class="gl-price">{%- if p.price_varies -%}From {% endif -%}{{ p.price | money }}{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}</span>
                {%- if p.available and p.variants.size == 1 -%}
                  {%- form 'product', p, class: 'gl-add' -%}
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <button class="gl-pill gl-pill--gold gl-glass" type="submit" aria-label="{{ section.settings.add_label | escape }}: {{ p.title | escape }}">{{ plus }}{{ section.settings.add_label | escape }}</button>
                  {%- endform -%}
                {%- elsif p.available -%}
                  <a class="gl-pill gl-pill--gold gl-glass" href="{{ p.url }}">{{ section.settings.options_label | escape }}</a>
                {%- else -%}
                  <span class="gl-pill gl-glass" aria-disabled="true" style="opacity:.6">{{ section.settings.soldout_label | escape }}</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
        {%- if shown > 0 -%}
          <a class="gl-end gl-pane" href="{{ shop_url }}">
            <span class="gl-end__text">{{ section.settings.end_heading | escape }}</span>
            <span class="gl-go" aria-hidden="true">{{ arrow }}</span>
          </a>
        {%- else -%}
          <div class="gl-empty gl-pane">
            <span class="gl-end__text">{{ section.settings.empty_heading | escape }}</span>
            <span class="gl-pill gl-glass">{{ section.settings.empty_label | escape }}</span>
          </div>
        {%- endif -%}
      </div>
      <button type="button" class="gl-nav gl-nav--prev gl-glass" data-gl-prev aria-label="Previous"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg></button>
      <button type="button" class="gl-nav gl-nav--next gl-glass" data-gl-next aria-label="Next"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></button>
    </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="gl-railwrap" data-gl-rails>
        <div class="gl-rail gl-infos" data-gl-rail>
          {%- for block in section.blocks -%}
            <div class="gl-info gl-pane" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}<span class="gl-tag">{{ block.settings.label | escape }}</span>{%- endif -%}
              {%- if block.type == 'newsletter' -%}
                {%- if block.settings.text != blank -%}<p class="gl-info__text">{{ block.settings.text | escape }}</p>{%- endif -%}
                {%- assign form_id = 'bls-join-' | append: block.id -%}
                {%- form 'customer', id: form_id, class: 'gl-join gl-glass' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p class="gl-note" role="status">{{ block.settings.success | escape }}</p>
                  {%- else -%}
                    {%- if form.errors -%}<p class="gl-note" role="alert">{{ block.settings.error | escape }}</p>{%- endif -%}
                    <input type="email" name="contact[email]" autocomplete="email" placeholder="{{ block.settings.placeholder | escape }}" aria-label="{{ block.settings.placeholder | escape }}" required>
                    <button type="submit" aria-label="{{ block.settings.button | escape }}">{{ arrow }}</button>
                  {%- endif -%}
                {%- endform -%}
              {%- else -%}
                {%- if block.settings.heading != blank -%}<p class="gl-info__big">{{ block.settings.heading | escape }}</p>{%- endif -%}
                {%- if block.settings.text != blank -%}<p class="gl-info__text">{{ block.settings.text | escape }}</p>{%- endif -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Glass product row",
  "max_blocks": 4,
  "settings": [
    {"type": "checkbox", "id": "show_products", "label": "Show the product row", "info": "Turn off when the category switch shows the products.", "default": true},
    {"type": "text", "id": "label", "label": "Small label", "default": "New in"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Latest finds"},
    {"type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products."},
    {"type": "range", "id": "products_to_show", "label": "Products in the row", "min": 2, "max": 16, "step": 1, "default": 10},
    {"type": "text", "id": "all_label", "label": "First chip", "default": "All"},
    {"type": "text", "id": "flag", "label": "Badge on the first product", "default": "New"},
    {"type": "checkbox", "id": "blend", "label": "Blend white product photo backgrounds into the card", "default": true},
    {"type": "header", "content": "Buttons"},
    {"type": "text", "id": "add_label", "label": "Add to cart", "default": "Add"},
    {"type": "text", "id": "options_label", "label": "Product with options", "default": "Options"},
    {"type": "text", "id": "soldout_label", "label": "Sold out", "default": "Sold out"},
    {"type": "text", "id": "end_heading", "label": "Last card", "default": "See everything"},
    {"type": "header", "content": "When there are no products yet"},
    {"type": "text", "id": "empty_heading", "label": "Heading", "default": "New finds are on the way"},
    {"type": "text", "id": "empty_label", "label": "Label", "default": "Coming soon"}
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info card",
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "Delivery"},
        {"type": "text", "id": "heading", "label": "Large line"},
        {"type": "textarea", "id": "text", "label": "Text"}
      ]
    },
    {
      "type": "newsletter",
      "name": "Email sign-up",
      "limit": 1,
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "Join now"},
        {"type": "text", "id": "text", "label": "Text", "default": "New finds and offers by email."},
        {"type": "text", "id": "placeholder", "label": "Field text", "default": "Email"},
        {"type": "text", "id": "button", "label": "Button (read by screen readers)", "default": "Subscribe"},
        {"type": "text", "id": "success", "label": "Message after signing up", "default": "Thank you. You are on the list."},
        {"type": "text", "id": "error", "label": "Message when the email is not accepted", "default": "Please check the email address."}
      ]
    }
  ],
  "presets": [{"name": "Glass product row", "blocks": [{"type": "info"}, {"type": "newsletter"}, {"type": "info"}]}]
}
{% endschema %}
