<script>
(function(){
  var h=document.documentElement,K='bls-lite',saved=null;
  try{saved=sessionStorage.getItem(K)}catch(_){}
  var n=navigator,c=n.connection||{};
  var weak=(n.deviceMemory&&n.deviceMemory<=2)||(n.hardwareConcurrency&&n.hardwareConcurrency<=2)||c.saveData||/(^|-)2g$/.test(c.effectiveType||'');
  var still=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  function lite(on){h.classList.toggle(K,!!on);try{sessionStorage.setItem(K,on?'1':'0')}catch(_){}}
  if(saved==='1'||weak||still){lite(true);return}
  if(saved==='0')return;
  /* measure once per visit, a moment after the page has settled: if frames come too slowly, switch to eco */
  function measure(){
    if(document.hidden){document.addEventListener('visibilitychange',function v(){if(!document.hidden){document.removeEventListener('visibilitychange',v);setTimeout(measure,600)}});return}
    var d=[],last=0,t0=0;
    function f(t){
      if(!t0){t0=last=t;return requestAnimationFrame(f)}
      d.push(t-last);last=t;
      if(t-t0<1400)return requestAnimationFrame(f);
      if(document.hidden||d.length<8){return}
      d.sort(function(a,b){return a-b});
      var med=d[d.length>>1],slow=0;for(var i=0;i<d.length;i++)if(d[i]>34)slow++;
      lite(med>24||slow/d.length>.35);
    }
    requestAnimationFrame(f);
  }
  function go(){setTimeout(measure,2500)}
  if(document.readyState==='complete')go();else addEventListener('load',go,{once:true});
})();
</script>
