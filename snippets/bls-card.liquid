{%- comment -%}One product card on the glass look. Params: product, blend (true/false), eager (true/false).{%- endcomment -%}
{%- liquid
  assign card_variant = product.selected_or_first_available_variant
  assign load = 'lazy'
  if eager
    assign load = 'eager'
  endif
  assign on_sale = false
  if product.compare_at_price > product.price and product.available
    assign on_sale = true
    assign off = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif
-%}
<article class="bls-item pg-card">
  <a class="bls-item__media{% if blend %} bls-shot{% endif %}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: load, alt: product.featured_image.alt | default: product.title, widths: '240, 360, 480, 600', sizes: '(max-width: 700px) 46vw, (max-width: 1040px) 30vw, 280px' }}
    {%- endif -%}
    {%- if on_sale -%}<span class="pg-sale">-{{ off }}%</span>{%- elsif product.available == false -%}<span class="pg-sale" style="background:rgba(20,22,32,.8)">{{ 'pg.sold_out' | t }}</span>{%- endif -%}
  </a>
  <div class="bls-item__info">
    <a class="bls-item__title" href="{{ product.url }}">{{ product.title | escape }}</a>
  </div>
  <div class="pg-card__row">
    <span class="bls-item__price">{{ product.price | money }}{% if on_sale %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</span>
    {%- if product.available -%}
      {%- if product.variants.size == 1 -%}
        {%- form 'product', product, class: 'pg-card__add' -%}
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <button class="pg-card__btn" type="submit" aria-label="{{ 'pg.add' | t }}: {{ product.title | escape }}">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
          </button>
        {%- endform -%}
      {%- else -%}
        <a class="pg-card__btn" href="{{ product.url }}" aria-label="{{ 'pg.options' | t }}: {{ product.title | escape }}">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg>
        </a>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>
