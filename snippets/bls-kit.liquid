{%- comment -%}Shared look of every inner page (cart, product, search, pages, blog): dark glass on a soft space backdrop. Rendered by the glass layout.{%- endcomment -%}
<style>
.pg{position:relative;z-index:3;padding:112px 0 64px;color:var(--bls-white,#F4F6FB);min-height:70vh}
.pg::before{content:'';position:fixed;top:0;left:0;right:0;bottom:0;z-index:-1;pointer-events:none;background:radial-gradient(60% 38% at 12% 0%,rgba(96,116,210,.24),rgba(96,116,210,0) 70%),radial-gradient(46% 34% at 92% 8%,rgba(227,180,88,.13),rgba(227,180,88,0) 70%),radial-gradient(1.2px 1.2px at 40px 60px,rgba(255,255,255,.7),transparent),radial-gradient(1px 1px at 170px 140px,rgba(255,233,201,.6),transparent),radial-gradient(1.2px 1.2px at 280px 30px,rgba(207,224,255,.6),transparent),#04050A;background-size:auto,auto,320px 240px,320px 240px,320px 240px,auto}
.pg-wrap{max-width:1180px;margin:0 auto;padding:0 28px}
.pg-wrap--narrow{max-width:760px}
.pg-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:10px 20px;margin:0 0 26px}
.pg-eyebrow{margin:0 0 8px;font-family:var(--bls-display,'Jost',sans-serif);font-size:12px;font-weight:500;letter-spacing:.3em;text-transform:uppercase;color:var(--bls-gold,#E3B458)}
.pg-h1{margin:0;font-family:var(--bls-display,'Jost',sans-serif);font-size:clamp(30px,4.2vw,48px);font-weight:300;line-height:1.08;letter-spacing:.02em}
.pg-link{display:inline-flex;align-items:center;gap:6px;color:var(--bls-muted,#B7BECF);font-size:14px;font-weight:600}
.pg-link:hover{color:var(--bls-gold,#E3B458)}
.pg-panel{position:relative;padding:24px;border-radius:28px;background:var(--bls-smoke,rgba(13,15,23,.62));border:1px solid var(--bls-line,rgba(255,255,255,.2));box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 24px 60px rgba(0,0,0,.4);-webkit-backdrop-filter:blur(18px) saturate(140%);backdrop-filter:blur(18px) saturate(140%)}
.pg-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:0 26px;border-radius:999px;font:700 15px/1 var(--bls-body,'Manrope',sans-serif);cursor:pointer;text-align:center;border:1px solid rgba(236,196,116,.62);background:linear-gradient(135deg,rgba(236,196,116,.34) 0%,rgba(227,180,88,.12) 52%,rgba(236,196,116,.24) 100%);color:#F8E6BC;box-shadow:inset 0 1px 0 rgba(255,238,196,.45),0 10px 30px rgba(227,180,88,.14);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
.pg-btn:hover{border-color:rgba(246,214,150,.95);transform:translateY(-2px)}
.pg-btn:active{transform:scale(.98)}
.pg-btn[disabled]{opacity:.5;cursor:default;transform:none}
.pg-btn--ghost{border-color:rgba(255,255,255,.3);background:linear-gradient(135deg,rgba(255,255,255,.14),rgba(255,255,255,.04));color:#F4F6FB;font-weight:600;box-shadow:inset 0 1px 0 rgba(255,255,255,.25)}
.pg-btn--wide{width:100%}
.pg-in{width:100%;min-height:50px;padding:13px 18px;border-radius:18px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.07);color:#fff;font:500 16px/1.4 var(--bls-body,'Manrope',sans-serif);outline:0;transition:border-color .2s ease}
.pg-in::placeholder{color:rgba(244,246,251,.55)}
.pg-in:focus{border-color:var(--bls-gold,#E3B458)}
textarea.pg-in{min-height:130px;resize:vertical;border-radius:22px}
.pg-label{display:block;margin:0 0 7px;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--bls-muted,#B7BECF)}
.pg-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 12px;font-size:15px;font-weight:700}
.pg-price s{font-size:.8em;font-weight:500;opacity:.6}
.pg-sale{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:999px;background:linear-gradient(135deg,rgba(255,120,96,.9),rgba(224,70,60,.8));color:#fff;font-size:11px;font-weight:700}
.pg-qty{display:inline-flex;align-items:center;gap:2px;padding:3px;border-radius:999px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.07)}
.pg-qty button{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;font-size:18px;line-height:1;cursor:pointer}
.pg-qty button:hover{background:rgba(255,255,255,.2)}
.pg-qty span,.pg-qty input{min-width:36px;width:44px;border:0;background:none;color:#fff;font:700 15px/1 var(--bls-body,'Manrope',sans-serif);text-align:center;outline:0;-moz-appearance:textfield}
.pg-qty input::-webkit-outer-spin-button,.pg-qty input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.pg-empty{display:flex;flex-direction:column;align-items:center;gap:14px;padding:56px 20px;text-align:center}
.pg-empty p{margin:0;max-width:420px;color:var(--bls-muted,#B7BECF)}
.pg-empty__mark{display:flex;align-items:center;justify-content:center;width:74px;height:74px;border-radius:50%;border:1px solid var(--bls-line,rgba(255,255,255,.2));background:rgba(255,255,255,.06);color:var(--bls-gold,#E3B458)}
.pg-rte{font-size:16px;line-height:1.75;color:#DCE0EA}
.pg-rte h2,.pg-rte h3{font-family:var(--bls-display,'Jost',sans-serif);font-weight:400;color:#fff;margin:1.6em 0 .5em}
.pg-rte a{color:var(--bls-gold,#E3B458);text-decoration:underline;text-underline-offset:3px}
.pg-rte img{border-radius:18px;height:auto}
.pg-rte p{margin:0 0 1em}
.pg-rte ul,.pg-rte ol{padding-left:1.3em;margin:0 0 1em}
.pg-msg{margin:0 0 16px;padding:12px 16px;border-radius:16px;font-size:14px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.07)}
.pg-msg--ok{border-color:rgba(120,220,160,.5);background:rgba(60,160,100,.14)}
.pg-msg--err{border-color:rgba(255,120,110,.55);background:rgba(220,70,60,.14)}
.pg-pages{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px;margin:34px 0 0}
.pg-pages a,.pg-pages span{display:inline-flex;align-items:center;justify-content:center;min-width:42px;height:42px;padding:0 14px;border-radius:999px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.06);font-size:14px;font-weight:600}
.pg-pages .is-on{background:rgba(227,180,88,.22);border-color:rgba(227,180,88,.7);color:#F8E6BC}
.pg-pages a:hover{border-color:rgba(255,255,255,.5)}
/* product cards (used by search, related and lists): the home card look plus an add button */
.pg-card .bls-item__info{flex:1 1 auto}
.pg-card__row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding:6px 8px 0}
.pg-card__row .bls-item__price{font-weight:700}
.pg-card__add{margin:0}
.pg-card__btn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;padding:0;border-radius:50%;border:1px solid rgba(236,196,116,.6);background:rgba(227,180,88,.18);color:#F8E6BC;cursor:pointer;transition:transform .2s ease,background-color .2s ease}
.pg-card__btn:hover{background:rgba(227,180,88,.34);transform:translateY(-1px)}
.pg-card__btn.is-busy{opacity:.5;pointer-events:none}
.pg-card .bls-item__media{position:relative}
.pg-card .pg-sale{position:absolute;top:8px;left:8px}
.bls-account{display:none}
@media (min-width:901px){.bls-account{display:inline-flex}}
@media (max-width:700px){.pg{padding-top:92px}.pg-wrap{padding:0 14px}.pg-panel{padding:16px;border-radius:24px}}
@media (hover:none) and (pointer:coarse){.pg-panel{-webkit-backdrop-filter:none;backdrop-filter:none;background:rgba(18,21,32,.78)}}
@media (prefers-reduced-motion:reduce){.pg *{transition:none!important}}
</style>
