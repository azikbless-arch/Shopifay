{%- comment -%} Bright photo look for the Home & Living collection page {%- endcomment -%}
{%- assign hs_img = images['b008e2b7-00d4-4606-9c3b-61662eddf521.png'] -%}
<div class="hs-bg" aria-hidden="true">
  {%- if hs_img != blank -%}
    <img alt="" decoding="async" sizes="100vw" src="{{ hs_img | image_url: width: 1600 }}" srcset="{{ hs_img | image_url: width: 800 }} 800w, {{ hs_img | image_url: width: 1200 }} 1200w, {{ hs_img | image_url: width: 1448 }} 1448w">
  {%- else -%}
    <img alt="" decoding="async" src="{{ 'bls-home-bg.webp' | asset_url }}">
  {%- endif -%}
</div>
<style>
.hs-bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;overflow:hidden;background:#d9e4ef;pointer-events:none}
.hs-bg img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 42%}
.hs-bg::after{content:"";position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(180deg,rgba(255,250,242,.2) 0%,rgba(255,246,232,.06) 38%,rgba(110,76,44,.22) 100%)}
@media (max-width:700px){.hs-bg img{object-position:40% 40%}}
html,body.bs-body.template-collection{background:transparent !important;color:#3A2A1D}
body.template-collection .bs-main,body.template-collection .bs-main>*,body.template-collection .bs-v25-theater,body.template-collection .bs-v25-stage{background-color:transparent !important;background-image:none !important}
body.template-collection h1,body.template-collection h2,body.template-collection h3,body.template-collection .bs-eyebrow{color:#3A2A1D;text-shadow:0 1px 18px rgba(255,250,240,.8)}
body.template-collection .bs-living-collection-hero,body.template-collection .bs-filters,body.template-collection .bs-sortbar,body.template-collection .bs-product-card,body.template-collection .bs-collection-nav a,body.template-collection .bs-v25-theater .bs-product-card{color:#3A2A1D;background:linear-gradient(145deg,rgba(255,255,255,.66) 0%,rgba(255,255,255,.2) 44%,rgba(255,241,222,.42) 100%),rgba(255,247,236,.3) !important;border:1px solid rgba(255,255,255,.75) !important;-webkit-backdrop-filter:blur(18px) saturate(150%);backdrop-filter:blur(18px) saturate(150%);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 12px 30px rgba(96,66,38,.2) !important}
body.template-collection .bs-product-card a,body.template-collection .bs-product-card p,body.template-collection .bs-product-card span{color:#3A2A1D}
body.template-collection .bs-btn,body.template-collection button[type=submit]{background:linear-gradient(135deg,rgba(224,184,134,.95),rgba(176,128,79,.88) 55%,rgba(206,160,110,.95)) !important;color:#FFF9EE !important;border-color:rgba(255,236,208,.8) !important}
</style>
