{%- comment -%}Shared look of the home rails: chrome glass, compact swipe rows. Rendered by bls-rail and bls-shelf.{%- endcomment -%}
<style>
.gl-block{position:relative;z-index:3;padding:22px 0 2px;scroll-margin-top:84px;--gl-pad:12px;--gl-gap:10px;--gl-r:22px;color:#F4F6FB}
@media (min-width:701px){.gl-block{--gl-pad:28px;--gl-gap:14px;--gl-r:26px;padding-top:30px}}
.gl-wrap{max-width:1296px;margin:0 auto;padding:0 var(--gl-pad)}
.gl-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:10px 16px;margin:0 0 10px}
.gl-title{display:flex;flex-direction:column;gap:6px;min-width:0}
.gl-eyebrow{margin:0;font-family:var(--bls-display,'Jost',sans-serif);font-size:11px;font-weight:500;letter-spacing:.3em;text-transform:uppercase;color:var(--bls-gold,#E3B458)}
.gl-h2{margin:0;font-family:var(--bls-display,'Jost',sans-serif);font-size:clamp(24px,3.2vw,34px);font-weight:400;line-height:1.08;color:#fff;text-shadow:0 2px 20px rgba(0,0,0,.55)}

/* chrome glass: a bright thin rim, a soft sheen, a dark tint so text stays readable even when the blur is missing */
.gl-glass,.gl-pane{position:relative;color:#fff;background:linear-gradient(145deg,rgba(255,255,255,.2) 0%,rgba(255,255,255,.04) 42%,rgba(255,255,255,.11) 100%),rgba(20,23,34,.52);box-shadow:inset 0 1px 0 rgba(255,255,255,.42),inset 0 -1px 0 rgba(255,255,255,.07),0 10px 26px rgba(0,0,0,.3)}
.gl-glass{-webkit-backdrop-filter:blur(14px) saturate(165%);backdrop-filter:blur(14px) saturate(165%)}
.gl-glass::after,.gl-pane::after,.gl-cat::after{content:'';position:absolute;top:0;left:0;right:0;bottom:0;border-radius:inherit;padding:1px;pointer-events:none;background:linear-gradient(135deg,rgba(255,255,255,.8) 0%,rgba(255,255,255,.12) 30%,rgba(255,255,255,.05) 56%,rgba(255,255,255,.55) 100%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.gl-glass{background:rgba(28,31,44,.92)}}

/* buttons */
.gl-pill{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:0 15px;border:0;border-radius:999px;font-family:var(--bls-body,'Manrope',sans-serif);font-size:13px;font-weight:600;line-height:1;white-space:nowrap;cursor:pointer;text-decoration:none;transition:transform .2s ease}
@media (hover:hover){.gl-pill:hover{transform:translateY(-1px)}}
.gl-pill:active{transform:scale(.97)}
.gl-pill[disabled]{opacity:.55;cursor:default}
.gl-pill--gold{background:linear-gradient(135deg,rgba(246,214,150,.52) 0%,rgba(227,180,88,.14) 55%,rgba(246,214,150,.32) 100%),rgba(54,40,14,.5);color:#FBEBC6}
.gl-pill--gold::after{background:linear-gradient(135deg,rgba(255,238,196,.95),rgba(236,196,116,.16) 34%,rgba(236,196,116,.08) 60%,rgba(255,226,160,.75))}
.gl-go{display:inline-flex;align-items:center;justify-content:center;flex:none;width:32px;height:32px;border-radius:50%;background:rgba(244,246,251,.94);color:#0B0D14;box-shadow:0 4px 12px rgba(0,0,0,.28);transition:transform .25s ease}
@media (hover:hover){.gl-cat:hover .gl-go,.gl-end:hover .gl-go{transform:rotate(45deg)}}
.gl-chips{display:flex;gap:8px;max-width:100%;padding:2px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.gl-chips::-webkit-scrollbar{display:none}
.gl-chips .gl-pill{flex:none}
@media (max-width:700px){.gl-chips{flex:1 1 100%;margin:0 calc(var(--gl-pad) * -1);padding:2px var(--gl-pad)}}

/* the swipe rows: the page and the background stay put, the row slides, cards snap */
.gl-railwrap{position:relative}
.gl-rail{display:grid;grid-auto-flow:column;gap:var(--gl-gap);margin:0 calc(var(--gl-pad) * -1);padding:4px var(--gl-pad) 22px;scroll-padding-left:var(--gl-pad);overflow-x:auto;overflow-y:hidden;scroll-snap-type:x proximity;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;scrollbar-width:none;touch-action:pan-x pan-y;outline:0}
.gl-rail::-webkit-scrollbar{display:none}
.gl-rail>*{scroll-snap-align:start;min-width:0}
.gl-rail.is-drag{scroll-snap-type:none;cursor:grabbing;user-select:none}
.gl-rail img{-webkit-user-drag:none;user-select:none}
.gl-rail:focus-visible{outline:2px solid var(--bls-gold,#E3B458);outline-offset:-2px;border-radius:var(--gl-r)}
.gl-nav{display:none;position:absolute;top:calc(50% - 25px);z-index:5;width:42px;height:42px;padding:0;border:0;border-radius:50%;align-items:center;justify-content:center;cursor:pointer}
.gl-nav--prev{left:-4px}
.gl-nav--next{right:-4px}
@media (hover:hover) and (pointer:fine){.gl-railwrap.has-more:not(.is-start) .gl-nav--prev,.gl-railwrap.has-more:not(.is-end) .gl-nav--next{display:inline-flex}}
@media (max-width:700px){.gl-railwrap::after{content:'';position:absolute;top:0;bottom:16px;right:calc(var(--gl-pad) * -1);width:28px;background:linear-gradient(90deg,rgba(4,5,10,0),rgba(4,5,10,.55));pointer-events:none;opacity:0;transition:opacity .2s ease}.gl-railwrap.has-more:not(.is-end)::after{opacity:1}}

/* category cards: compact, a picture with a glass name plate */
.gl-cats{grid-auto-columns:clamp(148px,42vw,190px)}
@media (min-width:701px){.gl-cats{grid-auto-columns:minmax(210px,1fr)}}
.gl-cat{position:relative;display:block;overflow:hidden;isolation:isolate;aspect-ratio:4 / 5;border-radius:var(--gl-r);background:#0A0C13;color:#fff;box-shadow:0 14px 34px rgba(0,0,0,.38)}
@media (min-width:701px){.gl-cat{aspect-ratio:auto;height:clamp(210px,19vw,250px)}}
.gl-cat__media{position:absolute;top:0;left:0;width:100%;height:100%;z-index:-1}
.gl-cat__media>img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
@media (hover:hover){.gl-cat:hover .gl-cat__media>img{transform:scale(1.04)}}
.gl-cat::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;pointer-events:none;background:linear-gradient(180deg,rgba(6,8,14,.34) 0%,rgba(6,8,14,0) 36%,rgba(6,8,14,0) 52%,rgba(6,8,14,.52) 100%)}
.gl-cat__plate{position:absolute;left:8px;right:8px;bottom:8px;display:flex;align-items:center;gap:8px;min-width:0;padding:6px 6px 6px 14px;border-radius:20px}
.gl-cat__text{display:flex;flex-direction:column;gap:2px;flex:1 1 auto;min-width:0}
.gl-cat__name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--bls-display,'Jost',sans-serif);font-size:14px;font-weight:500;letter-spacing:.05em;text-transform:uppercase}
.gl-cat__sub{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.78)}
.gl-cat--soon{cursor:default}
.gl-badge{position:absolute;top:10px;left:10px;display:inline-flex;align-items:center;height:26px;padding:0 11px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}

/* product cards */
.gl-prods{grid-auto-columns:clamp(150px,44vw,190px)}
@media (min-width:701px){.gl-prods{grid-auto-columns:230px}}
.gl-prod{display:flex;flex-direction:column;min-width:0;padding:6px;border-radius:var(--gl-r)}
.gl-prod__media{position:relative;display:block;aspect-ratio:1 / 1;overflow:hidden;border-radius:calc(var(--gl-r) - 7px);background:#0A0C13}
.gl-prod__media>img{display:block;width:100%;height:100%;object-fit:cover}
.gl-flag{position:absolute;top:8px;left:8px;display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 11px;border-radius:999px;font-size:11px;font-weight:700}
.gl-flag::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--bls-gold,#E3B458)}
.gl-flag::after{content:none}
.gl-prod__body{display:flex;flex-direction:column;gap:8px;flex:1 1 auto;padding:10px 6px 4px}
.gl-prod__title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;min-height:2.6em;font-size:13px;font-weight:600;line-height:1.3}
.gl-prod__row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto}
.gl-price{font-size:15px;font-weight:700;line-height:1.1;white-space:nowrap}
.gl-price s{display:block;font-size:11px;font-weight:500;opacity:.6}
.gl-add{margin:0;flex:none}
.gl-add .gl-pill,.gl-prod__row>.gl-pill{min-height:36px;padding:0 13px}
.gl-end{display:flex;flex-direction:column;justify-content:space-between;gap:14px;padding:16px;border-radius:var(--gl-r);text-decoration:none}
.gl-end__text{font-family:var(--bls-display,'Jost',sans-serif);font-size:20px;line-height:1.15}
.gl-empty{display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:18px;border-radius:var(--gl-r)}

/* small info cards and the sign-up */
.gl-infos{margin-top:-8px;grid-auto-columns:clamp(220px,68vw,300px)}
@media (min-width:701px){.gl-infos{grid-auto-columns:minmax(240px,1fr)}}
.gl-info{display:flex;flex-direction:column;gap:6px;padding:14px 16px;border-radius:var(--gl-r)}
.gl-tag{align-self:flex-start;display:inline-flex;align-items:center;height:22px;padding:0 10px;border-radius:999px;border:1px solid rgba(255,255,255,.45);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
.gl-info__big{margin:0;font-family:var(--bls-display,'Jost',sans-serif);font-size:19px;line-height:1.15}
.gl-info__text{margin:0;font-size:12.5px;line-height:1.4;color:#DCE0EA}
.gl-join{display:flex;align-items:center;gap:6px;margin:4px 0 0;padding:4px 4px 4px 14px;border-radius:999px}
.gl-join input[type=email]{flex:1 1 auto;min-width:0;height:34px;padding:0;border:0;background:none;color:#fff;font-size:16px;outline:0}
.gl-join input::placeholder{color:rgba(244,246,251,.7)}
.gl-join button{display:inline-flex;align-items:center;justify-content:center;flex:none;width:34px;height:34px;padding:0;border:0;border-radius:50%;background:rgba(244,246,251,.94);color:#0B0D14;cursor:pointer}
.gl-note{margin:0;font-size:12.5px;color:#DCE0EA}
@media (prefers-reduced-motion:reduce){.gl-block *{transition:none!important}}
</style>
<script>
(function(){
  if(window.BlsRails)return;
  window.BlsRails=1;
  function setup(box){
    if(box.__gl)return;
    box.__gl=1;
    var rail=box.querySelector('[data-gl-rail]');
    if(!rail)return;
    var prev=box.querySelector('[data-gl-prev]');
    var next=box.querySelector('[data-gl-next]');
    var down=false,moved=false,sx=0,sl=0;
    function update(){
      var max=rail.scrollWidth-rail.clientWidth;
      box.classList.toggle('has-more',max>6);
      box.classList.toggle('is-start',rail.scrollLeft<=4);
      box.classList.toggle('is-end',rail.scrollLeft>=max-4);
    }
    function by(d){rail.scrollBy({left:d*Math.max(160,rail.clientWidth*0.8),behavior:'smooth'});}
    rail.addEventListener('scroll',update,{passive:true});
    if(window.ResizeObserver)new ResizeObserver(update).observe(rail);else window.addEventListener('resize',update);
    if(prev)prev.addEventListener('click',function(){by(-1);});
    if(next)next.addEventListener('click',function(){by(1);});
    /* a mouse can drag the row like a finger; touch scrolls natively */
    rail.addEventListener('pointerdown',function(e){
      if(e.pointerType!=='mouse'||e.button!==0)return;
      down=true;moved=false;sx=e.clientX;sl=rail.scrollLeft;
    });
    window.addEventListener('pointermove',function(e){
      if(!down)return;
      var dx=e.clientX-sx;
      if(!moved&&Math.abs(dx)>5){moved=true;rail.classList.add('is-drag');}
      if(moved)rail.scrollLeft=sl-dx;
    });
    function end(){
      if(!down)return;
      down=false;
      if(moved){rail.classList.remove('is-drag');window.setTimeout(function(){moved=false;},0);}
    }
    window.addEventListener('pointerup',end);
    window.addEventListener('pointercancel',end);
    rail.addEventListener('click',function(e){if(moved){e.preventDefault();e.stopPropagation();}},true);
    rail.addEventListener('dragstart',function(e){e.preventDefault();});
    update();
  }
  function scan(root){
    var list=(root||document).querySelectorAll('[data-gl-rails]');
    for(var i=0;i<list.length;i++)setup(list[i]);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){scan();});else scan();
  document.addEventListener('shopify:section:load',function(e){scan(e.target);});
})();
</script>
