{%- comment -%}App shell: bottom tab bar on phones, the catalog sheet (multi-menu) everywhere, soft page transitions. Rendered by both layouts.{%- endcomment -%}
{%- liquid
  assign ab_page = request.page_type
  assign ab_count = cart.item_count
-%}
<nav class="ab-bar" aria-label="{{ 'bls.app' | t }}" data-ab-bar>
  <a class="ab-tab{% if ab_page == 'index' %} is-on{% endif %}" href="{{ routes.root_url }}"{% if ab_page == 'index' %} aria-current="page"{% endif %}>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11l8-7 8 7"></path><path d="M6 10v10h12V10"></path></svg><span>{{ 'bls.home' | t }}</span>
  </a>
  <button class="ab-tab{% if ab_page == 'collection' or ab_page == 'list-collections' %} is-on{% endif %}" type="button" data-bls-catalog aria-haspopup="dialog" aria-expanded="false">
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="6.5" height="6.5" rx="1.6"></rect><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"></rect><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"></rect><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6"></rect></svg><span>{{ 'bls.catalog' | t }}</span>
  </button>
  <a class="ab-tab" href="{{ routes.root_url }}#deals" data-ab-deals>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12.5L12.5 20a2 2 0 0 1-2.8 0L4 14.3V4h10.3L20 9.7a2 2 0 0 1 0 2.8z"></path><circle cx="8.5" cy="8.5" r="1.2"></circle></svg><span>{{ 'bls.deals' | t }}</span>
  </a>
  <a class="ab-tab{% if ab_page == 'cart' %} is-on{% endif %}" href="{{ routes.cart_url }}">
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6L5 8z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg><span>{{ 'bls.cart' | t }}</span>
    {%- if ab_count > 0 -%}<i class="ab-count">{{ ab_count }}</i>{%- endif -%}
  </a>
  <a class="ab-tab" href="{{ routes.account_url }}">
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"></circle><path d="M5 20c.8-3.6 3.6-5.4 7-5.4s6.2 1.8 7 5.4"></path></svg><span>{{ 'bls.profile' | t }}</span>
  </a>
</nav>
<div class="ab-layer" data-ab-layer aria-hidden="true">
  <div class="ab-back" data-ab-close></div>
  <div class="ab-sheet" role="dialog" aria-modal="true" aria-label="{{ 'bls.catalog' | t }}" tabindex="-1" data-ab-sheet>
    <div class="ab-grab" data-ab-grab><span></span></div>
    <div class="ab-head">
      <form class="ab-search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" placeholder="{{ 'bls.search' | t }}" aria-label="{{ 'bls.search' | t }}" autocomplete="off">
        <button type="submit" aria-label="{{ 'bls.search' | t }}"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path></svg></button>
      </form>
      <button class="ab-x" type="button" data-ab-close aria-label="{{ 'bls.close' | t }}"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg></button>
    </div>
    <div class="ab-grid">
      {%- for c in collections -%}
        {%- if c.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        {%- assign pic = c.image | default: c.products.first.featured_image -%}
        {%- if c.all_products_count > 0 -%}
        <a class="ab-card" href="{{ c.url }}">
          <span class="ab-card__pic">{%- if pic != blank -%}{{ pic | image_url: width: 360 | image_tag: loading: 'lazy', alt: '', widths: '180, 270, 360', sizes: '(max-width: 900px) 45vw, 200px' }}{%- endif -%}</span>
          <span class="ab-card__name">{{ c.title | escape }}</span>
          <span class="ab-card__sub">{{ c.all_products_count }}</span>
        </a>
        {%- else -%}
        <span class="ab-card is-soon">
          <span class="ab-card__pic"></span>
          <span class="ab-card__name">{{ c.title | escape }}</span>
          <span class="ab-card__sub">{{ 'bls.coming_soon' | t }}</span>
        </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="ab-links">
      <a class="ab-pill" href="{{ routes.all_products_collection_url }}">{{ 'bls.shop_all' | t }}</a>
      <a class="ab-pill" href="{{ routes.root_url }}#deals" data-ab-deals data-ab-close>{{ 'bls.deals' | t }}</a>
      {%- if pages.contact.title != blank -%}<a class="ab-pill" href="{{ pages.contact.url }}">{{ 'bls.contact' | t }}</a>{%- endif -%}
      {%- if pages.faq.title != blank -%}<a class="ab-pill" href="{{ pages.faq.url }}">{{ 'bls.faq' | t }}</a>{%- endif -%}
      {%- render 'bls-lang', lang_id: 'BlsLangSheet' -%}
    </div>
  </div>
</div>
<style>
@view-transition{navigation:auto}
::view-transition-old(root){animation:ab-out .22s ease both}
::view-transition-new(root){animation:ab-in .32s ease both}
.ab-bar{view-transition-name:ab-bar}
@keyframes ab-out{to{opacity:0}}
@keyframes ab-in{from{opacity:0;transform:translateY(6px)}}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
@media (prefers-reduced-motion:reduce){@view-transition{navigation:none}}
:root{--ab-ink:#F4F6FB;--ab-mute:rgba(244,246,251,.7);--ab-gold:#F2CB82;--ab-tint:rgba(18,21,32,.62);--ab-sheet:rgba(16,19,30,.9);--ab-line:rgba(255,255,255,.2);--ab-card:rgba(255,255,255,.08)}
body[data-skin="home"],body:has(.hs-bg){--ab-ink:#3A2A1D;--ab-mute:rgba(58,42,29,.7);--ab-gold:#9A6A3C;--ab-tint:rgba(255,247,236,.66);--ab-sheet:rgba(255,248,238,.92);--ab-line:rgba(255,255,255,.8);--ab-card:rgba(255,255,255,.55)}
.ab-bar{display:none}
.bls-navbtn{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
@media (max-width:900px){
  body{padding-bottom:calc(84px + env(safe-area-inset-bottom,0px))}
  .ab-bar{position:fixed;left:12px;right:12px;bottom:calc(10px + env(safe-area-inset-bottom,0px));z-index:900;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2px;padding:6px;border-radius:26px;color:var(--ab-ink);background:linear-gradient(145deg,rgba(255,255,255,.2),rgba(255,255,255,.04) 45%,rgba(255,255,255,.1)),var(--ab-tint);border:1px solid var(--ab-line);box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 14px 34px rgba(0,0,0,.34);-webkit-backdrop-filter:blur(20px) saturate(170%);backdrop-filter:blur(20px) saturate(170%)}
  .ab-tab{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:52px;min-width:0;overflow:hidden;padding:4px 0;border:0;border-radius:20px;background:none;color:inherit;font:600 10.5px/1 var(--bls-body,'Manrope',system-ui,sans-serif);letter-spacing:.02em;text-decoration:none;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:background .25s ease,color .25s ease,transform .2s ease}
  .ab-tab>span{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ab-tab:active{transform:scale(.93)}
  .ab-tab.is-on{color:var(--ab-gold);background:rgba(255,255,255,.14)}
  .ab-tab:focus-visible{outline:2px solid var(--ab-gold);outline-offset:-2px}
  .ab-count{position:absolute;top:3px;left:calc(50% + 6px);min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:var(--ab-gold);color:#17120A;font:700 10px/17px var(--bls-body,system-ui,sans-serif);text-align:center;font-style:normal}
}
.ab-layer{position:fixed;top:0;left:0;right:0;bottom:0;z-index:1000;visibility:hidden;pointer-events:none;transition:visibility 0s linear .35s}
.ab-layer.is-open{visibility:visible;pointer-events:auto;transition:none}
.ab-back{position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(4,6,12,.5);opacity:0;transition:opacity .3s ease;-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}
.ab-layer.is-open .ab-back{opacity:1}
.ab-sheet{position:absolute;left:0;right:0;bottom:0;max-height:86vh;max-height:86dvh;overflow-y:auto;overscroll-behavior:contain;padding:0 16px calc(18px + env(safe-area-inset-bottom,0px));border-radius:28px 28px 0 0;color:var(--ab-ink);background:linear-gradient(160deg,rgba(255,255,255,.16),rgba(255,255,255,.03) 40%),var(--ab-sheet);border:1px solid var(--ab-line);border-bottom:0;box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 -18px 50px rgba(0,0,0,.35);-webkit-backdrop-filter:blur(26px) saturate(170%);backdrop-filter:blur(26px) saturate(170%);transform:translateY(105%);transition:transform .42s cubic-bezier(.2,.8,.2,1);outline:0;touch-action:pan-y}
.ab-layer.is-open .ab-sheet{transform:none}
.ab-sheet.is-drag{transition:none}
.ab-grab{display:flex;justify-content:center;padding:10px 0 8px;cursor:grab}
.ab-grab span{width:42px;height:5px;border-radius:3px;background:var(--ab-mute);opacity:.6}
.ab-head{display:flex;align-items:center;gap:10px;margin:2px 0 14px}
.ab-search{display:flex;align-items:center;flex:1 1 auto;min-width:0;gap:6px;padding:4px 4px 4px 16px;border-radius:999px;background:var(--ab-card);border:1px solid var(--ab-line)}
.ab-search input{flex:1 1 auto;min-width:0;height:38px;padding:0;border:0;background:none;color:inherit;font-size:16px;outline:0}
.ab-search input::placeholder{color:var(--ab-mute)}
.ab-search button,.ab-x{display:inline-flex;align-items:center;justify-content:center;flex:none;width:38px;height:38px;padding:0;border:0;border-radius:50%;background:var(--ab-card);color:inherit;cursor:pointer}
.ab-x{border:1px solid var(--ab-line)}
.ab-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.ab-card{position:relative;display:flex;flex-direction:column;gap:2px;padding:6px 6px 10px;border-radius:20px;color:inherit;text-decoration:none;background:var(--ab-card);border:1px solid var(--ab-line);transition:transform .25s ease}
.ab-card:active{transform:scale(.97)}
.ab-card__pic{display:block;aspect-ratio:4 / 3;overflow:hidden;border-radius:15px;background:linear-gradient(135deg,rgba(227,180,88,.35),rgba(120,140,200,.25))}
.ab-card__pic img{display:block;width:100%;height:100%;object-fit:cover}
.ab-card__name{padding:6px 6px 0;font:600 14px/1.2 var(--bls-body,'Manrope',system-ui,sans-serif)}
.ab-card__sub{padding:0 6px;font-size:11px;color:var(--ab-mute)}
.ab-card.is-soon{opacity:.62;cursor:default}
.ab-links{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:14px}
.ab-pill{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border-radius:999px;color:inherit;font:600 13px/1 var(--bls-body,'Manrope',system-ui,sans-serif);text-decoration:none;background:var(--ab-card);border:1px solid var(--ab-line)}
@media (min-width:901px){
  .ab-sheet{left:50%;right:auto;bottom:auto;top:92px;width:min(880px,calc(100vw - 48px));max-height:calc(100vh - 140px);padding:0 22px 22px;border-radius:30px;border-bottom:1px solid var(--ab-line);transform:translate(-50%,-14px) scale(.98);opacity:0;transition:transform .32s cubic-bezier(.2,.8,.2,1),opacity .25s ease}
  .ab-layer.is-open .ab-sheet{transform:translate(-50%,0);opacity:1}
  .ab-grab{display:none}
  .ab-head{margin-top:20px}
  .ab-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
}
body.ab-lock{overflow:hidden}
@media (prefers-reduced-motion:reduce){.ab-sheet,.ab-back,.ab-tab{transition:none}}
</style>
<script>
(function(){
  if(window.BlsApp)return;
  window.BlsApp=1;
  var D=document,B=function(){return D.body};
  var layer,sheet,last=null;
  function q(){layer=layer||D.querySelector('[data-ab-layer]');sheet=sheet||D.querySelector('[data-ab-sheet]');return layer&&sheet;}
  function sync(open){
    var l=D.querySelectorAll('[data-bls-catalog]');
    for(var i=0;i<l.length;i++)l[i].setAttribute('aria-expanded',open?'true':'false');
  }
  function open(from){
    if(!q())return;
    D.dispatchEvent(new CustomEvent('bls:overlay:opening',{detail:{name:'catalog'}}));
    last=from||D.activeElement;
    layer.classList.add('is-open');
    layer.setAttribute('aria-hidden','false');
    B().classList.add('ab-lock');
    sync(true);
    sheet.style.transform='';
    window.setTimeout(function(){try{sheet.focus({preventScroll:true});}catch(e){}},30);
  }
  function close(){
    if(!q()||!layer.classList.contains('is-open'))return;
    layer.classList.remove('is-open');
    layer.setAttribute('aria-hidden','true');
    B().classList.remove('ab-lock');
    sheet.classList.remove('is-drag');
    sheet.style.transform='';
    sync(false);
    if(last&&last.focus){try{last.focus({preventScroll:true});}catch(e){}}
  }
  D.addEventListener('click',function(e){
    var t=e.target.closest&&e.target.closest('[data-bls-catalog]');
    if(t){
      e.preventDefault();
      /* the header menu on a phone is a <details>: close it, then show the sheet */
      var det=t.closest('details');if(det)det.open=false;
      layer&&layer.classList.contains('is-open')?close():open(t);
      return;
    }
    var x=e.target.closest&&e.target.closest('[data-ab-close]');
    if(x&&layer&&layer.contains(x)){close();}
  });
  D.addEventListener('keydown',function(e){
    if(e.key==='Escape'){close();return;}
    if(e.key!=='Tab'||!layer||!layer.classList.contains('is-open')||!sheet)return;
    var list=Array.from(sheet.querySelectorAll('a[href],button:not([disabled]),input:not([disabled]),select:not([disabled])')).filter(function(el){return el.getClientRects().length>0;});
    if(!list.length){e.preventDefault();sheet.focus();return;}
    var first=list[0],last=list[list.length-1];
    if(e.shiftKey&&(D.activeElement===first||!sheet.contains(D.activeElement))){e.preventDefault();last.focus();}
    else if(!e.shiftKey&&(D.activeElement===last||!sheet.contains(D.activeElement))){e.preventDefault();first.focus();}
  });
  D.addEventListener('bls:overlay:opening',function(e){if(e.detail&&e.detail.name!=='catalog')close();});
  /* "Deals" on the home page just scrolls there; on other pages it follows the link to the home page */
  D.addEventListener('click',function(e){
    var a=e.target.closest&&e.target.closest('[data-ab-deals]');
    if(!a)return;
    var el=D.getElementById('deals');
    if(el){e.preventDefault();close();el.scrollIntoView({behavior:'smooth',block:'start'});}
  });
  /* swipe down to close the sheet on a phone */
  var sy=0,dy=0,drag=false;
  D.addEventListener('touchstart',function(e){
    if(!q()||!layer.classList.contains('is-open')||window.innerWidth>900)return;
    if(!sheet.contains(e.target))return;
    var onGrab=e.target.closest('[data-ab-grab],.ab-head');
    if(sheet.scrollTop>0&&!onGrab)return;
    sy=e.touches[0].clientY;dy=0;drag=true;
  },{passive:true});
  D.addEventListener('touchmove',function(e){
    if(!drag)return;
    dy=e.touches[0].clientY-sy;
    if(dy<=0){if(sheet.classList.contains('is-drag')){sheet.style.transform='';}return;}
    sheet.classList.add('is-drag');
    sheet.style.transform='translateY('+dy+'px)';
    if(e.cancelable)e.preventDefault();
  },{passive:false});
  function end(){
    if(!drag)return;
    drag=false;
    sheet.classList.remove('is-drag');
    if(dy>90){close();}else{sheet.style.transform='';}
    dy=0;
  }
  D.addEventListener('touchend',end,{passive:true});
  D.addEventListener('touchcancel',end,{passive:true});
  /* go back to a normal page when it is restored from the browser cache */
  window.addEventListener('pageshow',function(e){if(e.persisted)close();});
})();
</script>
