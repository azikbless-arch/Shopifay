<style>
.px-wrap{max-width:1100px;margin:0 auto}
.px-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:18px}
.px-stage{position:relative;aspect-ratio:4/5;border-radius:28px;overflow:hidden;background:#0A0C13;color:#fff}
.px-stage.bls-shot{background:radial-gradient(120% 90% at 50% 42%,#D8D7DD 0%,#B9B8C0 58%,#8E8D96 100%)}
.px-track{position:absolute;top:0;left:0;width:100%;height:100%;display:flex;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.px-track::-webkit-scrollbar{display:none}
.px-s{position:relative;flex:0 0 100%;height:100%;scroll-snap-align:center}
.px-s img{display:block;width:100%;height:100%;object-fit:cover}
.px-stage.bls-shot .px-s img{object-fit:contain;mix-blend-mode:multiply}
.px-noimg{display:flex;align-items:center;justify-content:center;height:100%;letter-spacing:.3em;opacity:.7}
.px-sale{position:absolute;z-index:2;top:14px;left:14px;height:26px;font-size:12px}
.px-act{position:absolute;z-index:3;top:12px;right:12px;display:flex;gap:8px}
.px-act .xw-page{width:42px;height:42px;background:rgba(14,16,26,.5);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.px-dots{position:absolute;z-index:2;left:0;right:0;bottom:14px;display:flex;justify-content:center;gap:6px;pointer-events:none}
.px-dots i{width:6px;height:6px;border-radius:50%;background:rgba(20,22,32,.35);transition:width .25s ease,background-color .25s ease}
.px-dots i.is-on{width:18px;border-radius:3px;background:#1A1C26}
.px-stage:not(.bls-shot) .px-dots i{background:rgba(255,255,255,.45)}
.px-stage:not(.bls-shot) .px-dots i.is-on{background:#fff}

.px-info{display:flex;flex-direction:column;gap:14px;min-width:0;padding:0 4px}
.px-title{margin:0;font:300 clamp(24px,6.4vw,34px)/1.15 var(--bls-display,'Jost',sans-serif);letter-spacing:.005em}
.px-price{display:flex;align-items:baseline;gap:12px}
.px-price b{font:600 clamp(28px,8vw,38px)/1 var(--bls-display,'Jost',sans-serif);color:#F8E6BC}
.px-price s{font-size:16px;opacity:.55}
.px-price s[hidden]{display:none}
.px-buy{display:flex;flex-direction:column;gap:16px}
.px-opts{display:flex;flex-direction:column;gap:14px}
.px-buy .pgp__opt{margin:0;padding:0;border:0;min-width:0}
.px-buy .pgp__opt legend{padding:0;margin-bottom:8px}
.pgp__vals{display:flex;flex-wrap:wrap;gap:8px}
.pgp__val{position:relative;cursor:pointer}
.pgp__val input{position:absolute;opacity:0;width:100%;height:100%;left:0;top:0;cursor:pointer;margin:0}
.pgp__val span{display:inline-flex;align-items:center;justify-content:center;min-width:46px;min-height:42px;padding:0 16px;border-radius:999px;border:1px solid rgba(255,255,255,.24);background:rgba(255,255,255,.06);font-size:14px;font-weight:600;transition:border-color .2s ease,background-color .2s ease}
.pgp__val input:checked+span{border-color:var(--bls-gold,#E3B458);background:rgba(227,180,88,.2);color:#F8E6BC}
.pgp__val input:focus-visible+span{outline:2px solid var(--bls-gold,#E3B458);outline-offset:2px}
.pgp__val.is-off span{opacity:.42;text-decoration:line-through}
.px-add{display:inline-flex;align-items:center;justify-content:center;height:54px;padding:0 28px;border:0;border-radius:999px;background:linear-gradient(180deg,#F6D696 0%,#E3B458 100%);color:#1A1204;font:700 15px/1 var(--bls-body,'Manrope',sans-serif);cursor:pointer;box-shadow:0 10px 28px rgba(227,180,88,.28),inset 0 1px 0 rgba(255,255,255,.5);transition:transform .2s ease,opacity .2s ease;-webkit-tap-highlight-color:transparent}
.px-add:active{transform:scale(.97)}
.px-add[disabled]{opacity:.5;cursor:default;box-shadow:none}
.px-add.is-busy{opacity:.6;pointer-events:none}
.px-add:focus-visible{outline:2px solid #fff;outline-offset:2px}
.pgp__dyn .shopify-payment-button__button{border-radius:999px!important;min-height:48px}

.px-more{display:flex;flex-direction:column;border-top:1px solid rgba(255,255,255,.12);margin-top:4px}
.px-d{border-bottom:1px solid rgba(255,255,255,.12)}
.px-d summary{display:flex;align-items:center;justify-content:space-between;padding:16px 2px;font-size:15px;font-weight:600;cursor:pointer;list-style:none;-webkit-tap-highlight-color:transparent}
.px-d summary::-webkit-details-marker{display:none}
.px-d summary::after{content:"+";font-size:22px;font-weight:300;opacity:.7;line-height:1}
.px-d[open] summary::after{content:"\2212"}
.px-d .pg-rte{padding:0 2px 16px;font-size:14.5px;line-height:1.6;color:#DCE0EA}
.px-d .pg-rte p{margin:0 0 .7em}

.px-bar{display:none}
@media (max-width:900px){
section.px{padding-bottom:96px}
.px-info .px-buy>.px-add{display:none}
.px-bar{position:fixed;left:12px;right:12px;bottom:calc(88px + env(safe-area-inset-bottom,0px));z-index:850;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:7px 7px 7px 22px;border-radius:999px;background:rgba(18,20,30,.9);-webkit-backdrop-filter:blur(20px) saturate(150%);backdrop-filter:blur(20px) saturate(150%);border:1px solid rgba(255,255,255,.2);box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 14px 34px rgba(0,0,0,.5)}
.px-bar__p{display:flex;align-items:baseline;gap:8px;min-width:0;white-space:nowrap}
.px-bar__p b{font:600 20px/1 var(--bls-display,'Jost',sans-serif);color:#F8E6BC}
.px-bar__p s{font-size:12px;opacity:.55}
.px-bar__p s[hidden]{display:none}
.px-add--bar{height:46px;padding:0 24px;flex:none}
}
@media (min-width:901px){
.px-grid{grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:40px;align-items:start}
.px-stage{aspect-ratio:1/1;border-radius:34px}
.px-info{position:sticky;top:96px;padding:12px 0}
.px-title{font-size:38px}
.px-price b{font-size:40px}
.px-add{align-self:flex-start;min-width:260px}
}
html.bls-lite .px-bar{-webkit-backdrop-filter:none;backdrop-filter:none;background:rgba(18,20,30,.97)}
html.bls-lite .px-act .xw-page{-webkit-backdrop-filter:none;backdrop-filter:none}
@media (prefers-reduced-motion:reduce){.px-dots i,.px-add{transition:none}}
</style>
