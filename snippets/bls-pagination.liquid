{%- comment -%}Round page buttons. Param: paginate.{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pg-pages" aria-label="{{ 'bls.col.pages' | t }}">
    {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'bls.col.prev' | t }}">&larr;</a>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}<span class="is-on" aria-current="page">{{ part.title }}</span>
      {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'bls.col.next' | t }}">&rarr;</a>{%- endif -%}
  </nav>
{%- endif -%}
